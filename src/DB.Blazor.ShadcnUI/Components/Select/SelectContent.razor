@namespace DB.Blazor.ShadcnUI.Components
@inherits ShadcnDismissableBase

<div @ref="_panel" role="listbox" tabindex="-1" id="@Root?.ContentId"
     data-slot="select-content" data-state="@(Root?.IsOpen == true ? "open" : "closed")"
     aria-labelledby="@Root?.TriggerId" hidden="@(Root?.IsVisible != true)" class="@Classes"
     style="@Styles" @oncontextmenu:preventDefault="true" @attributes="AdditionalAttributes">
    <SelectScrollUpButton />
    <div class="@ViewportClasses">
        @ChildContent
    </div>
    <SelectScrollDownButton />
</div>

@code {
    private string? Styles => StyleWith(
        Root?.IsVisible == true
            // Out of flow before the browser paints: the shadcn class list says `relative`, which
            // would otherwise push the page layout for one frame until the placement script runs.
            ? "display: flex; flex-direction: column; outline: none; position: fixed; left: 0; top: 0; visibility: hidden;"
            : "display: none; flex-direction: column; outline: none;");

    private string? Classes => MergeClass(
        Cx(
            "relative z-50 max-h-(--radix-select-content-available-height) min-w-[8rem] " +
            "origin-(--radix-select-content-transform-origin) overflow-x-hidden overflow-y-auto " +
            "rounded-md border bg-popover text-popover-foreground shadow-md " +
            "data-[side=bottom]:slide-in-from-top-2 data-[side=left]:slide-in-from-right-2 " +
            "data-[side=right]:slide-in-from-left-2 data-[side=top]:slide-in-from-bottom-2 " +
            "data-[state=closed]:animate-out data-[state=closed]:fade-out-0 " +
            "data-[state=closed]:zoom-out-95 data-[state=open]:animate-in " +
            "data-[state=open]:fade-in-0 data-[state=open]:zoom-in-95",
            Position == SelectPosition.Popper
                ? "data-[side=bottom]:translate-y-1 data-[side=left]:-translate-x-1 " +
                  "data-[side=right]:translate-x-1 data-[side=top]:-translate-y-1"
                : null));

    private string? ViewportClasses => Cx(
        "p-1",
        Position == SelectPosition.Popper
            ? "h-[var(--radix-select-trigger-height)] w-full " +
              "min-w-[var(--radix-select-trigger-width)] scroll-my-1"
            : null);
}
