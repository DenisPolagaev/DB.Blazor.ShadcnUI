@namespace DB.Blazor.ShadcnUI.Components
@inherits ShadcnComponent
@implements IAsyncDisposable

<button @ref="_trigger" type="button" id="@Root?.TriggerId" role="combobox" aria-controls="@Root?.ContentId"
        aria-expanded="@(Root?.IsOpen == true ? "true" : "false")"
        aria-required="@(Root?.Required == true ? "true" : null)" aria-autocomplete="none"
        data-slot="select-trigger" data-size="@Size.ToDataValue()"
        data-state="@(Root?.IsOpen == true ? "open" : "closed")"
        data-disabled="@(IsDisabled ? "" : null)" data-placeholder="@(Root?.HasValue == true ? null : "")"
        disabled="@IsDisabled" class="@Classes" style="@Style" @onclick="ToggleAsync"
        @attributes="AdditionalAttributes">
    @ChildContent
    <ChevronDownIcon Class="cn-select-trigger-icon pointer-events-none" />
</button>

@code {
    [CascadingParameter] private Select? Root { get; set; }

    [Inject] private IJSRuntime Js { get; set; } = default!;

    private ElementReference _trigger;
    private IJSObjectReference? _module;

    /// <summary>Trigger height: <c>default</c> or <c>sm</c>.</summary>
    [Parameter] public SelectSize Size { get; set; } = SelectSize.Default;

    /// <summary>Disables the trigger in addition to the root's <see cref="Select.Disabled"/>.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>The <see cref="SelectValue"/> children.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool IsDisabled => Disabled || (Root?.Disabled ?? false);

    private Task ToggleAsync() => IsDisabled ? Task.CompletedTask : Root?.ToggleAsync() ?? Task.CompletedTask;

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _module ??= await ShadcnJs.ImportAsync(Js);
            await _module.InvokeVoidAsync("bindSelectTrigger", _trigger);
        }
        catch (Exception exception) when (exception is JSException or InvalidOperationException or JSDisconnectedException or ObjectDisposedException)
        {
        }
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (Exception exception) when (exception is JSException or JSDisconnectedException or ObjectDisposedException)
            {
            }
        }

        GC.SuppressFinalize(this);
    }

    private string? Classes => MergeClass("cn-select-trigger flex w-fit items-center justify-between whitespace-nowrap outline-none disabled:cursor-not-allowed disabled:opacity-50 *:data-[slot=select-value]:line-clamp-1 *:data-[slot=select-value]:flex *:data-[slot=select-value]:items-center [&_svg]:pointer-events-none [&_svg]:shrink-0");
}




