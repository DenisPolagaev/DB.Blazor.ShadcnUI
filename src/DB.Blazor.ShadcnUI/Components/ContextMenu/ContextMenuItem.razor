@namespace DB.Blazor.ShadcnUI.Components
@inherits ShadcnComponent

<div role="menuitem" data-slot="context-menu-item" data-inset="@(Inset ? "true" : null)"
     data-variant="@(Variant == DropdownMenuItemVariant.Destructive ? "destructive" : "default")"
     data-disabled="@(Disabled ? "true" : null)" aria-disabled="@(Disabled ? "true" : null)" tabindex="-1"
     class="@Classes" style="@Style" @onclick="HandleClickAsync" @keydown="HandleKeyDownAsync"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    [CascadingParameter] private ContextMenu? Root { get; set; }

    /// <summary>Indents the item to line up with items that have an indicator.</summary>
    [Parameter] public bool Inset { get; set; }

    /// <summary><c>default</c> or <c>destructive</c>.</summary>
    [Parameter] public DropdownMenuItemVariant Variant { get; set; } = DropdownMenuItemVariant.Default;

    /// <summary>Disables the item.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Runs when the item is chosen; the menu then closes.</summary>
    [Parameter] public EventCallback OnClick { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private async Task HandleClickAsync()
    {
        if (Disabled)
        {
            return;
        }

        await OnClick.InvokeAsync();
        if (Root is not null)
        {
            await Root.CloseAsync();
        }
    }

    private Task HandleKeyDownAsync(KeyboardEventArgs args) =>
        args.Key is "Enter" or " " ? HandleClickAsync() : Task.CompletedTask;

    private string? Classes => MergeClass("cn-context-menu-item group/context-menu-item relative flex cursor-default items-center outline-hidden select-none data-disabled:pointer-events-none data-disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0");
}

