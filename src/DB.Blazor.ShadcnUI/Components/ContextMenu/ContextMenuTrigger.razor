@namespace DB.Blazor.ShadcnUI.Components
@inherits ShadcnComponent

<span id="@Root?.TriggerId" data-slot="context-menu-trigger" class="cn-context-menu-trigger select-none" style="display: contents"
      aria-haspopup="menu" aria-expanded="@(Root?.IsOpen == true ? "true" : "false")"
      aria-controls="@Root?.ContentId"
      @oncontextmenu="HandleContextMenuAsync" @oncontextmenu:preventDefault="true"
      @attributes="AdditionalAttributes">@ChildContent</span>

@code {
    [CascadingParameter] private ContextMenu? Root { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private Task HandleContextMenuAsync(Microsoft.AspNetCore.Components.Web.MouseEventArgs args) =>
        Root?.OpenAtAsync(args.ClientX, args.ClientY) ?? Task.CompletedTask;
}

