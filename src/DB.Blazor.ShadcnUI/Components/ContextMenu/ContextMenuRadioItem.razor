@namespace DB.Blazor.ShadcnUI.Components
@inherits ShadcnComponent

<div role="menuitemradio" data-slot="context-menu-radio-item"
     data-state="@(Selected ? "checked" : "unchecked")" aria-checked="@(Selected ? "true" : "false")"
     data-disabled="@(Disabled ? "" : null)" aria-disabled="@(Disabled ? "true" : null)" tabindex="-1"
     class="@Classes" style="@Style" @onclick="HandleClickAsync" @keydown="HandleKeyDownAsync"
     @attributes="AdditionalAttributes">
    <span class="cn-context-menu-item-indicator pointer-events-none">
        @if (Selected)
        {
            <CircleIcon Class="size-2 fill-current" />
        }
    </span>
    @ChildContent
</div>

@code {
    [CascadingParameter] private ContextMenuRadioGroup? Group { get; set; }

    [CascadingParameter] private ContextMenu? Root { get; set; }

    /// <summary>The value this item represents.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Disables the item.</summary>
    [Parameter] public bool Disabled { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool Selected => Group?.IsSelected(Value) ?? false;

    private async Task HandleClickAsync()
    {
        if (Disabled)
        {
            return;
        }

        if (Group is not null)
        {
            await Group.SelectAsync(Value);
        }

        if (Root is not null)
        {
            await Root.CloseAsync();
        }
    }

    private Task HandleKeyDownAsync(KeyboardEventArgs args) =>
        args.Key is "Enter" or " " ? HandleClickAsync() : Task.CompletedTask;

    private string? Classes => MergeClass("cn-context-menu-radio-item relative flex cursor-default items-center outline-hidden select-none data-disabled:pointer-events-none data-disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0");
}

