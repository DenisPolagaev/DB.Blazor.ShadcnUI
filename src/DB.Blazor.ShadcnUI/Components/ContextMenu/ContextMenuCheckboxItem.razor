@namespace DB.Blazor.ShadcnUI.Components
@inherits ShadcnComponent


<div role="menuitemcheckbox" data-slot="context-menu-checkbox-item"
     data-state="@(Checked ? "checked" : "unchecked")" aria-checked="@(Checked ? "true" : "false")"
     data-disabled="@(Disabled ? "" : null)" aria-disabled="@(Disabled ? "true" : null)" tabindex="-1"
     class="@Classes" style="@Style" @onclick="HandleClickAsync" @keydown="HandleKeyDownAsync"
     @attributes="AdditionalAttributes">
    <span class="cn-context-menu-item-indicator pointer-events-none">
        @if (Checked)
        {
            <CheckIcon Class="size-4" />
        }
    </span>
    @ChildContent
</div>

@code {
    private ContextMenu? _root;

    [CascadingParameter] private ContextMenu? Root { get; set; }

    /// <summary>Checked state (<c>@bind-Checked</c>).</summary>
    [Parameter] public bool Checked { get; set; }

    /// <summary>Checked change callback.</summary>
    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }

    /// <summary>Disables the item.</summary>
    [Parameter] public bool Disabled { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <inheritdoc />
    protected override void OnInitialized() => _root = Root;

    private async Task HandleClickAsync()
    {
        if (Disabled)
        {
            return;
        }

        Checked = !Checked;
        await CheckedChanged.InvokeAsync(Checked);
        if (_root is not null)
        {
            await _root.CloseAsync();
        }
    }

    private Task HandleKeyDownAsync(KeyboardEventArgs args) =>
        args.Key is "Enter" or " " ? HandleClickAsync() : Task.CompletedTask;

    private string? Classes => MergeClass("cn-context-menu-checkbox-item relative flex cursor-default items-center outline-hidden select-none data-disabled:pointer-events-none data-disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0");
}



