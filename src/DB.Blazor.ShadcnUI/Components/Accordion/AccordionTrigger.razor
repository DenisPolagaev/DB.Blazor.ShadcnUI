@namespace DB.Blazor.ShadcnUI.Components

@inherits ShadcnComponent

<h3 data-orientation="vertical" class="flex">
    <button type="button" data-slot="accordion-trigger" data-state="@(Item?.Open == true ? "open" : "closed")"
            aria-expanded="@(Item?.Open == true ? "true" : "false")" aria-controls="@Item?.ContentId"
            id="@Item?.TriggerId" disabled="@(Item?.Disabled ?? false)" class="@Classes" style="@Style"
            @onclick="HandleClickAsync" @attributes="AdditionalAttributes">
        @ChildContent
        <PlusIcon data-slot="accordion-trigger-icon" Class="cn-accordion-trigger-icon pointer-events-none shrink-0 group-aria-expanded/accordion-trigger:hidden" />
        <MinusIcon data-slot="accordion-trigger-icon" Class="cn-accordion-trigger-icon pointer-events-none hidden shrink-0 group-aria-expanded/accordion-trigger:inline" />
    </button>
</h3>

@code {
    [CascadingParameter] private AccordionItem? Item { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private Task HandleClickAsync() => Item?.ToggleAsync() ?? Task.CompletedTask;

    private string? Classes => MergeClass("cn-accordion-trigger group/accordion-trigger relative flex flex-1 items-start justify-between border border-transparent transition-all outline-none disabled:pointer-events-none disabled:opacity-50");
}



