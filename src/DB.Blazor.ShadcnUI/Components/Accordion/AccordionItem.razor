@namespace DB.Blazor.ShadcnUI.Components

@inherits ShadcnComponent

<div data-slot="accordion-item" data-state="@(Open ? "open" : "closed")" data-disabled="@(Disabled ? "true" : null)"
     class="@Classes" style="@Style" @attributes="AdditionalAttributes">
    <CascadingValue Value="this" IsFixed="true">
        @ChildContent
    </CascadingValue>
</div>

@code {
    [CascadingParameter] private Accordion? Owner { get; set; }

    /// <summary>The value that identifies this item.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Disables the trigger and content interaction for this item.</summary>
    [Parameter] public bool Disabled { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>True when this item is expanded.</summary>
    public bool Open => Owner?.IsOpen(Value) ?? false;

    /// <summary>DOM id of the trigger, used by <c>aria-controls</c>/<c>aria-labelledby</c>.</summary>
    public string TriggerId => $"{ElementId}-trigger";

    /// <summary>DOM id of the panel.</summary>
    public string ContentId => $"{ElementId}-content";

    internal Task ToggleAsync() => Disabled || Owner is null ? Task.CompletedTask : Owner.ToggleAsync(Value);

    private string? Classes => MergeClass("cn-accordion-item");
}

