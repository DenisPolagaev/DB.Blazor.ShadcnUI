@namespace DB.Blazor.ShadcnUI.Components

@inherits ShadcnComponent

<textarea data-slot="textarea" placeholder="@Placeholder" disabled="@Disabled" readonly="@ReadOnly" name="@Name"
          class="@Classes" style="@Style" @oninput="HandleInputAsync" @attributes="AdditionalAttributes">@Value</textarea>

@code {
    /// <summary>Two-way bound value (<c>@bind-Value</c>).</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Value change callback.</summary>
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>Expression for validation messages inside an <c>EditForm</c>.</summary>
    [Parameter] public System.Linq.Expressions.Expression<Func<string?>>? ValueExpression { get; set; }

    /// <summary>Placeholder text.</summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Native <c>name</c>.</summary>
    [Parameter] public string? Name { get; set; }

    /// <summary>Disables the textarea.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Makes the textarea read-only.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    private async Task HandleInputAsync(ChangeEventArgs args)
    {
        Value = args.Value?.ToString();
        await ValueChanged.InvokeAsync(Value);
    }

    private string? Classes => MergeClass("cn-textarea flex field-sizing-content min-h-16 w-full outline-none placeholder:text-muted-foreground disabled:cursor-not-allowed disabled:opacity-50");
}


