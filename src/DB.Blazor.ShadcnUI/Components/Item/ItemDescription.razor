@namespace DB.Blazor.ShadcnUI.Components
@inherits ShadcnComponent

<p data-slot="item-description" class="@Classes" style="@Style" @attributes="AdditionalAttributes">
    @ChildContent
</p>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string? Classes => MergeClass("cn-item-description line-clamp-2 font-normal [&>a]:underline [&>a]:underline-offset-4 [&>a:hover]:text-primary");
}

