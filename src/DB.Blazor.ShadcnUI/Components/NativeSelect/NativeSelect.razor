@namespace DB.Blazor.ShadcnUI.Components

@inherits ShadcnComponent

<div class="cn-native-select-wrapper group/native-select relative w-fit has-[select:disabled]:opacity-50" data-slot="native-select-wrapper" data-size="@Size.ToDataValue()">
    <select data-slot="native-select" data-size="@Size.ToDataValue()" disabled="@Disabled"
            class="@Classes" style="@Style" @onchange="HandleChangeAsync" @attributes="AdditionalAttributes">
        @ChildContent
    </select>
    <ChevronDownIcon
        Class="cn-native-select-icon pointer-events-none absolute select-none"
        data-slot="native-select-icon" />
</div>

@code {
    /// <summary>Native select size.</summary>
    [Parameter] public NativeSelectSize Size { get; set; } = NativeSelectSize.Default;

    /// <summary>Two-way bound value (<c>@bind-Value</c>).</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Value change callback.</summary>
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>Disables the select.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary><see cref="NativeSelectOption"/> and <see cref="NativeSelectOptGroup"/> children.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private async Task HandleChangeAsync(ChangeEventArgs args)
    {
        Value = args.Value?.ToString();
        await ValueChanged.InvokeAsync(Value);
    }

    private string? Classes => MergeClass("cn-native-select outline-none disabled:pointer-events-none disabled:cursor-not-allowed");
}


