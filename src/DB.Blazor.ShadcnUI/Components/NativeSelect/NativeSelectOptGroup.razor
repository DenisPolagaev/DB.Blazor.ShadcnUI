@namespace DB.Blazor.ShadcnUI.Components

@inherits ShadcnComponent

<optgroup data-slot="native-select-optgroup" label="@Label" disabled="@Disabled" class="@Classes"
          style="@Style" @attributes="AdditionalAttributes">@ChildContent</optgroup>

@code {
    [Parameter] public string? Label { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string? Classes => MergeClass("bg-[Canvas] text-[CanvasText]");
}
