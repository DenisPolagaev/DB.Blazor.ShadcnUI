@namespace DB.Blazor.ShadcnUI.Components

@inherits ShadcnDismissableBase

@if (Root is { IsVisible: true })
{
    <div @ref="_panel" role="menu" tabindex="-1" data-slot="dropdown-menu-content" data-state="@(Root.IsOpen ? "open" : "closed")"
         id="@Root.ContentId" aria-labelledby="@Root.TriggerId" class="@Classes" style="@StyleWith("visibility: hidden")"
         @attributes="AdditionalAttributes">
        @ChildContent
    </div>
}

@code {
    private string? Classes => MergeClass("cn-dropdown-menu-content cn-menu-target cn-menu-translucent z-50 max-h-(--radix-dropdown-menu-content-available-height) w-(--radix-dropdown-menu-trigger-width) origin-(--radix-dropdown-menu-content-transform-origin) overflow-x-hidden overflow-y-auto data-[state=closed]:overflow-hidden");
}


