@namespace DB.Blazor.ShadcnUI.Components

@inherits ShadcnDismissableBase

@if (Owner is { IsVisible: true })
{
    <div @ref="_panel" role="menu" tabindex="-1" data-slot="dropdown-menu-sub-content" data-state="@(Owner.IsOpen ? "open" : "closed")"
         id="@Owner.ContentId" aria-labelledby="@Owner.TriggerId" class="@Classes" style="@Style"
         @onpointerenter="CancelClose" @onpointerleave="ScheduleClose" @attributes="AdditionalAttributes">
        @ChildContent
    </div>
}

@code {
    private string? Classes => MergeClass("cn-dropdown-menu-sub-content cn-menu-target cn-menu-translucent z-50 origin-(--radix-dropdown-menu-content-transform-origin) overflow-hidden");
}

