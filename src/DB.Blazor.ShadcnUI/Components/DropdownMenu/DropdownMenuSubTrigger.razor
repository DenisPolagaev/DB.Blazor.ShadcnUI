@namespace DB.Blazor.ShadcnUI.Components

@inherits ShadcnComponent

<div role="menuitem" data-slot="dropdown-menu-sub-trigger" data-inset="@(Inset ? "true" : null)"
     data-state="@(Owner?.IsOpen == true ? "open" : "closed")" aria-haspopup="menu"
     aria-expanded="@(Owner?.IsOpen == true ? "true" : "false")" aria-controls="@Owner?.ContentId"
     tabindex="-1" class="@Classes" style="@Style" @onclick="ToggleAsync" @keydown="HandleKeyDownAsync" @onpointerenter="OpenAsync"
     @onpointerleave="ScheduleClose" @attributes="AdditionalAttributes">
    @ChildContent
    <ChevronRightIcon Class="cn-rtl-flip ml-auto" />
</div>

@code {
    [CascadingParameter] private DropdownMenuSub? Owner { get; set; }

    /// <summary>Indents the item to line up with items that have an indicator.</summary>
    [Parameter] public bool Inset { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private Task ToggleAsync() => Owner?.ToggleAsync() ?? Task.CompletedTask;

    private Task OpenAsync() => Owner?.ShowAsync() ?? Task.CompletedTask;

    private Task HandleKeyDownAsync(KeyboardEventArgs args) =>
        args.Key is "Enter" or " " ? ToggleAsync() : Task.CompletedTask;

    private void ScheduleClose() => Owner?.ScheduleClose();

    private string? Classes => MergeClass("cn-dropdown-menu-sub-trigger flex cursor-default items-center outline-hidden select-none [&_svg]:pointer-events-none [&_svg]:shrink-0");
}



