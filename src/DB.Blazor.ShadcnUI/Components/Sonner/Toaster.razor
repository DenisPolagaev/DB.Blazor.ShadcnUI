@namespace DB.Blazor.ShadcnUI.Components
@implements IDisposable
@inject ToastService Toasts

@* shadcn's `sonner` is a thin wrapper around the Sonner package; the port reproduces its layout
   (bottom-right stack, title + description, dismiss button) on the shadcn tokens, with the same
   slide/fade utilities and an auto-dismiss timer. *@
<section data-slot="toaster" aria-label="Notifications" aria-live="polite"
         class="toaster group pointer-events-none fixed inset-x-0 bottom-0 z-50 flex flex-col items-center gap-2 p-4 sm:items-end">
    @foreach (var toast in Toasts.Toasts)
    {
        <div @key="toast.Id" data-slot="sonner-toast" data-state="open"
             class="cn-toast pointer-events-auto grid w-full max-w-sm gap-1 border bg-popover p-4 text-sm text-popover-foreground shadow-lg animate-in fade-in-0 slide-in-from-bottom-2">
            <div class="flex items-start justify-between gap-3">
                <div class="grid gap-1">
                    <div class="font-medium">@toast.Title</div>
                    @if (!string.IsNullOrWhiteSpace(toast.Description))
                    {
                        <div class="text-muted-foreground">@toast.Description</div>
                    }
                </div>
                <button type="button" aria-label="Close" class="rounded-xs opacity-70 transition-opacity hover:opacity-100"
                        @onclick="() => DismissAsync(toast.Id)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" class="size-4">
                        <path d="M18 6 6 18" />
                        <path d="m6 6 12 12" />
                    </svg>
                </button>
            </div>
            @if (!string.IsNullOrWhiteSpace(toast.Action))
            {
                <div class="text-xs font-medium text-primary">@toast.Action</div>
            }
        </div>
    }
</section>

@code {
    /// <summary>How long a toast stays on screen.</summary>
    [Parameter] public int DurationMilliseconds { get; set; } = 4000;

    private CancellationTokenSource? _timer;

    protected override void OnInitialized() => Toasts.Changed += HandleChanged;

    private void HandleChanged() => _ = InvokeAsync(async () =>
    {
        StateHasChanged();
        await ScheduleDismissAsync();
    });

    private async Task ScheduleDismissAsync()
    {
        _timer?.Cancel();
        _timer?.Dispose();
        _timer = new CancellationTokenSource();
        var token = _timer.Token;
        try
        {
            await Task.Delay(DurationMilliseconds, token);
            foreach (var toast in Toasts.Toasts.ToArray())
            {
                Toasts.Dismiss(toast.Id);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private Task DismissAsync(Guid id)
    {
        Toasts.Dismiss(id);
        return Task.CompletedTask;
    }

    /// <inheritdoc />
    public void Dispose()
    {
        Toasts.Changed -= HandleChanged;
        _timer?.Cancel();
        _timer?.Dispose();
    }
}

