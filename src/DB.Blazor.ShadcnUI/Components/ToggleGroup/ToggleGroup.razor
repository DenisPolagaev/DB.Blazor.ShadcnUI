@namespace DB.Blazor.ShadcnUI.Components
@inherits ShadcnComponent

<div role="group" data-slot="toggle-group" data-variant="@Variant.ToDataValue()" data-size="@Size.ToDataValue()"
     data-orientation="@Orientation.ToDataValue()" data-spacing="@Spacing"
     style="@StyleWith($"--gap: {Spacing}")" class="@Classes" @attributes="AdditionalAttributes">
    <CascadingValue Value="this" IsFixed="true">
        @ChildContent
    </CascadingValue>
</div>

@code {
    private string? Classes => MergeClass("cn-toggle-group group/toggle-group flex w-fit flex-row items-center gap-[--spacing(var(--gap))] data-vertical:flex-col data-vertical:items-stretch");
}

