@namespace DB.Blazor.ShadcnUI.Components

@inherits ShadcnDismissableBase

@if (Root is { IsVisible: true })
{
    <div @ref="_panel" tabindex="-1" data-slot="popover-content" data-state="@(Root.IsOpen ? "open" : "closed")" id="@Root.ContentId"
         class="@Classes" style="@StyleWith("visibility: hidden")" @attributes="AdditionalAttributes">
        @ChildContent
    </div>
}

@code {
    private string? Classes => MergeClass("cn-popover-content z-50 w-72 origin-(--radix-popover-content-transform-origin) outline-hidden");
}


