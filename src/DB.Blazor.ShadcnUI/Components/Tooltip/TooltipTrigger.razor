@namespace DB.Blazor.ShadcnUI.Components

@implements IDisposable
@inherits ShadcnComponent

<span @ref="_trigger" id="@Root?.TriggerId" data-slot="tooltip-trigger" style="display: contents"
      @attributes="AdditionalAttributes">@ChildContent</span>

@code {
    [CascadingParameter] private Tooltip? Root { get; set; }

    [CascadingParameter] private TooltipSettings? Settings { get; set; }

    [Inject] private IJSRuntime Js { get; set; } = default!;

    private ElementReference _trigger;
    private DotNetObjectReference<TooltipTrigger>? _self;
    private IJSObjectReference? _module;

    /// <summary>The control the tooltip describes.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private CancellationTokenSource? _pending;

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _module ??= await ShadcnJs.ImportAsync(Js);
            _self ??= DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("bindHoverTrigger", _trigger, _self);
        }
        catch (Exception exception) when (exception is JSException or InvalidOperationException or JSDisconnectedException or ObjectDisposedException)
        {
        }
    }

    /// <summary>The browser entered or focused the trigger (the wrapper has no box of its own).</summary>
    [JSInvokable]
    public void RequestOpen() => OpenDelayed();

    /// <summary>The browser left or blurred the trigger.</summary>
    [JSInvokable]
    public void RequestClose() => CloseNow();

    private void OpenDelayed()
    {
        if (Root is null)
        {
            return;
        }

        _pending?.Cancel();
        _pending?.Dispose();
        _pending = new CancellationTokenSource();
        _ = OpenAsync(_pending.Token);
    }

    private async Task OpenAsync(CancellationToken token)
    {
        try
        {
            var delay = Settings?.DelayDuration ?? 0;
            if (delay > 0)
            {
                await Task.Delay(delay, token);
            }

            if (!token.IsCancellationRequested && Root is not null)
            {
                await Root.ShowAsync();
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void CloseNow()
    {
        _pending?.Cancel();
        if (Root is not null)
        {
            _ = Root.CloseAsync();
        }
    }

    /// <inheritdoc />
    public void Dispose()
    {
        _pending?.Cancel();
        _pending?.Dispose();
        _self?.Dispose();
        _ = DisposeModuleAsync();
    }

    private async Task DisposeModuleAsync()
    {
        if (_module is null)
        {
            return;
        }

        try
        {
            await _module.DisposeAsync();
        }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException or ObjectDisposedException)
        {
        }
    }
}
