@namespace DB.Blazor.ShadcnUI.Components

@inherits ShadcnDismissableBase

@if (Root is { IsVisible: true })
{
    <div @ref="_panel" data-slot="tooltip-content" data-state="@(Root.IsOpen ? "open" : "closed")" role="tooltip" id="@Root.ContentId"
         class="@Classes" style="@Style" @attributes="AdditionalAttributes">
        @ChildContent
        <span data-slot="tooltip-arrow"
              class="cn-tooltip-arrow z-50 bg-foreground fill-foreground"></span>
    </div>
}

@code {
    private string? Classes => MergeClass("cn-tooltip-content z-50 w-fit max-w-xs origin-(--radix-tooltip-content-transform-origin) bg-foreground text-background");
}

