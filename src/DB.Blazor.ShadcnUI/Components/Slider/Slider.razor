@namespace DB.Blazor.ShadcnUI.Components
@inherits ShadcnComponent

@* Radix drives the slider with pointer events; the port overlays a native range input on the same
   markup, so dragging, touch and keyboard work without custom JS and the visuals stay identical. *@
<div data-slot="slider" data-orientation="@Orientation.ToDataValue()" data-disabled="@(Disabled ? "true" : null)"
     class="@Classes" style="@Style" @attributes="AdditionalAttributes">
    <div data-slot="slider-track" data-orientation="@Orientation.ToDataValue()" class="@TrackClasses">
        <div data-slot="slider-range" data-orientation="@Orientation.ToDataValue()" class="@RangeClasses" style="@RangeStyle"></div>
    </div>
    <div data-slot="slider-thumb" data-orientation="@Orientation.ToDataValue()" class="@ThumbClasses" style="@ThumbStyle"></div>
    <input type="range" min="@MinText" max="@MaxText" step="@StepText" value="@ValueText"
           disabled="@Disabled" aria-label="@AriaLabel"
           class="absolute inset-0 h-full w-full cursor-pointer opacity-0" style="@InputStyle"
           @oninput="HandleInputAsync" />
</div>

@code {
    /// <summary>Current value.</summary>
    [Parameter] public double Value { get; set; }

    /// <summary>Value change callback.</summary>
    [Parameter] public EventCallback<double> ValueChanged { get; set; }

    /// <summary>Lower bound, 0 by default.</summary>
    [Parameter] public double Min { get; set; }

    /// <summary>Upper bound, 100 by default.</summary>
    [Parameter] public double Max { get; set; } = 100;

    /// <summary>Step, 1 by default.</summary>
    [Parameter] public double Step { get; set; } = 1;

    /// <summary>Layout direction.</summary>
    [Parameter] public ShadcnOrientation Orientation { get; set; } = ShadcnOrientation.Horizontal;

    /// <summary>Disables the slider.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Accessible label for the range input.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    private double Percent => Max <= Min ? 0 : Math.Clamp((Value - Min) / (Max - Min) * 100d, 0d, 100d);

    private string MinText => Min.ToString(CultureInfo.InvariantCulture);

    private string MaxText => Max.ToString(CultureInfo.InvariantCulture);

    private string StepText => Step.ToString(CultureInfo.InvariantCulture);

    private string ValueText => Value.ToString(CultureInfo.InvariantCulture);

    private string? InputStyle => Orientation == ShadcnOrientation.Vertical
        ? "writing-mode: vertical-lr; direction: rtl"
        : null;

    private string? RangeStyle => StyleWith(Orientation == ShadcnOrientation.Vertical
        ? $"height: {Percent.ToString("0.###", CultureInfo.InvariantCulture)}%"
        : $"width: {Percent.ToString("0.###", CultureInfo.InvariantCulture)}%");

    private string ThumbStyle
    {
        get
        {
            var percent = Percent.ToString("0.###", CultureInfo.InvariantCulture);
            return Orientation == ShadcnOrientation.Vertical
                ? $"bottom: calc({percent}% - 0.375rem); left: 50%; transform: translateX(-50%)"
                : $"left: calc({percent}% - 0.375rem); top: 50%; transform: translateY(-50%)";
        }
    }

    private async Task HandleInputAsync(ChangeEventArgs args)
    {
        if (double.TryParse(args.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var next))
        {
            Value = next;
            await ValueChanged.InvokeAsync(next);
        }
    }

    private string? Classes => MergeClass("cn-slider relative flex w-full touch-none items-center select-none data-disabled:opacity-50 data-vertical:h-full data-vertical:w-auto data-vertical:flex-col");

    private static string TrackClasses => "cn-slider-track relative grow overflow-hidden data-horizontal:w-full data-vertical:h-full";

    private static string RangeClasses => "cn-slider-range absolute select-none data-horizontal:h-full data-vertical:w-full";

    private static string ThumbClasses => "cn-slider-thumb block shrink-0 select-none disabled:pointer-events-none disabled:opacity-50";
}



