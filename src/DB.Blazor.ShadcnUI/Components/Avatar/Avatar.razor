@namespace DB.Blazor.ShadcnUI.Components

@inherits ShadcnComponent

<span data-slot="avatar" data-size="@Size.ToDataValue()" class="@Classes" style="@Style" @attributes="AdditionalAttributes">
    <CascadingValue Value="this" IsFixed="true">
        @ChildContent
    </CascadingValue>
</span>

@code {
    private string? Classes => MergeClass("cn-avatar group/avatar relative flex shrink-0 select-none after:absolute after:inset-0 after:border after:border-border after:mix-blend-darken dark:after:mix-blend-lighten");
}

