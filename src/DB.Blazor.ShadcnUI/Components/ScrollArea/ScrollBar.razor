@namespace DB.Blazor.ShadcnUI.Components
@inherits ShadcnComponent

<div data-slot="scroll-area-scrollbar" data-orientation="@Orientation.ToDataValue()" class="@Classes"
     style="@Style" @attributes="AdditionalAttributes">
    <div data-slot="scroll-area-thumb" class="cn-scroll-area-thumb relative flex-1 bg-border"></div>
</div>

@code {
    /// <summary>Scrollbar orientation.</summary>
    [Parameter] public ShadcnOrientation Orientation { get; set; } = ShadcnOrientation.Vertical;

    private string? Classes => MergeClass("cn-scroll-area-scrollbar flex touch-none p-px transition-colors select-none");
}

