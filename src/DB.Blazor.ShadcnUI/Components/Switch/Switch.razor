@namespace DB.Blazor.ShadcnUI.Components

@inherits ShadcnComponent

<button type="button" role="switch" data-slot="switch" data-size="@Size.ToDataValue()"
        data-state="@(Checked ? "checked" : "unchecked")" aria-checked="@(Checked ? "true" : "false")"
        disabled="@Disabled" class="@Classes" style="@Style" @onclick="ToggleAsync" @attributes="AdditionalAttributes">
    <span data-slot="switch-thumb" data-state="@(Checked ? "checked" : "unchecked")" class="@ThumbClasses"></span>
</button>

@code {
    /// <summary>Checked state (<c>@bind-Checked</c>).</summary>
    [Parameter] public bool Checked { get; set; }

    /// <summary>Checked change callback.</summary>
    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }

    /// <summary>Expression for validation messages inside an <c>EditForm</c>.</summary>
    [Parameter] public System.Linq.Expressions.Expression<Func<bool>>? CheckedExpression { get; set; }

    /// <summary>Switch size, <c>default</c> out of the box.</summary>
    [Parameter] public SwitchSize Size { get; set; } = SwitchSize.Default;

    /// <summary>Disables the switch.</summary>
    [Parameter] public bool Disabled { get; set; }

    private async Task ToggleAsync()
    {
        if (Disabled)
        {
            return;
        }

        Checked = !Checked;
        await CheckedChanged.InvokeAsync(Checked);
    }

    private string? Classes => MergeClass("cn-switch peer group/switch relative inline-flex items-center transition-all outline-none after:absolute after:-inset-x-3 after:-inset-y-2 data-disabled:cursor-not-allowed data-disabled:opacity-50");

    private static string ThumbClasses =>
        "cn-switch-thumb pointer-events-none block ring-0 transition-transform" +
        "group-data-[size=default]/switch:size-4 group-data-[size=sm]/switch:size-3 " +
        "data-[state=checked]:translate-x-[calc(100%-2px)] data-[state=unchecked]:translate-x-0 " +
        "dark:data-[state=checked]:bg-primary-foreground dark:data-[state=unchecked]:bg-foreground";
}


