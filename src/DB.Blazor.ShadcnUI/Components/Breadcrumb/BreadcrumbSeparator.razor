@namespace DB.Blazor.ShadcnUI.Components

@inherits ShadcnComponent

<li data-slot="breadcrumb-separator" role="presentation" aria-hidden="true" class="@Classes" style="@Style"
    @attributes="AdditionalAttributes">
    @if (ChildContent is null)
    {
        <ChevronRightIcon />
    }
    else
    {
        @ChildContent
    }
</li>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string? Classes => MergeClass("[&>svg]:size-3.5");
}
