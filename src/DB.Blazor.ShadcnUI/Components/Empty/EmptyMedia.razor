@namespace DB.Blazor.ShadcnUI.Components
@inherits ShadcnComponent

<div data-slot="empty-icon" data-variant="@(Variant == EmptyMediaVariant.Icon ? "icon" : "default")"
     class="@Classes" style="@Style" @attributes="AdditionalAttributes">@ChildContent</div>

@code {
    /// <summary><c>default</c> (a bare glyph) or <c>icon</c> (a rounded muted tile).</summary>
    [Parameter] public EmptyMediaVariant Variant { get; set; } = EmptyMediaVariant.Default;

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string? Classes => MergeClass(Cx("cn-empty-media flex shrink-0 items-center justify-center [&_svg]:pointer-events-none [&_svg]:shrink-0", Variant == EmptyMediaVariant.Icon ? "cn-empty-media-icon" : "cn-empty-media-default"));
}

