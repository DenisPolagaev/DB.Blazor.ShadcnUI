@namespace DB.Blazor.ShadcnUI.Components

@inherits ShadcnComponent

<p data-slot="alert-dialog-description" id="@Root?.DescriptionId" class="@Classes" style="@Style"
   @attributes="AdditionalAttributes">@ChildContent</p>

@code {
    [CascadingParameter] private AlertDialog? Root { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string? Classes => MergeClass("text-sm text-muted-foreground");
}
