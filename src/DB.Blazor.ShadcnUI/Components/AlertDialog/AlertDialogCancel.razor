@namespace DB.Blazor.ShadcnUI.Components

@inherits ShadcnComponent

<Button Variant="Variant" Size="Size" Class="@Class" OnClick="InvokeAsync" data-slot="alert-dialog-cancel" @attributes="AdditionalAttributes">
    @ChildContent
</Button>

@code {
    [CascadingParameter] private AlertDialog? Root { get; set; }

    /// <summary>Button variant, <c>outline</c> like shadcn's cancel.</summary>
    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Outline;

    /// <summary>Button size.</summary>
    [Parameter] public ButtonSize Size { get; set; } = ButtonSize.Default;

    /// <summary>Runs after the dialog closed.</summary>
    [Parameter] public EventCallback OnClick { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private async Task InvokeAsync()
    {
        if (Root is not null)
        {
            await Root.CloseAsync();
        }

        await OnClick.InvokeAsync();
    }
}
