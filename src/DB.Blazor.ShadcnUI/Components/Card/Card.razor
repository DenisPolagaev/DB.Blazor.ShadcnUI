@namespace DB.Blazor.ShadcnUI.Components

@inherits ShadcnComponent

<div data-slot="card" data-size="@Size.ToDataValue()" class="@Classes" style="@Style" @attributes="AdditionalAttributes">@ChildContent</div>

@code {
    /// <summary>Card padding density (<c>default</c> or <c>sm</c>).</summary>
    [Parameter] public CardSize Size { get; set; } = CardSize.Default;

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string? Classes => MergeClass("cn-card group/card flex flex-col");
}
