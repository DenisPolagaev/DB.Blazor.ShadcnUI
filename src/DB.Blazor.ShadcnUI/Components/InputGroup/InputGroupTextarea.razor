@namespace DB.Blazor.ShadcnUI.Components
@inherits ShadcnComponent

<textarea data-slot="input-group-control" placeholder="@Placeholder" disabled="@Disabled" name="@Name"
          class="@Classes" style="@Style" @oninput="HandleInputAsync" @attributes="AdditionalAttributes">@Value</textarea>

@code {
    /// <summary>Two-way bound value (<c>@bind-Value</c>).</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Value change callback.</summary>
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>Placeholder text.</summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Native <c>name</c>.</summary>
    [Parameter] public string? Name { get; set; }

    /// <summary>Disables the textarea.</summary>
    [Parameter] public bool Disabled { get; set; }

    private async Task HandleInputAsync(ChangeEventArgs args)
    {
        Value = args.Value?.ToString();
        await ValueChanged.InvokeAsync(Value);
    }

    private string? Classes => MergeClass(
        "flex-1 resize-none rounded-none border-0 bg-transparent py-3 shadow-none focus-visible:ring-0 " +
        "dark:bg-transparent field-sizing-content min-h-16 w-full px-3 text-base " +
        "transition-[color,box-shadow] outline-none placeholder:text-muted-foreground " +
        "disabled:cursor-not-allowed disabled:opacity-50 md:text-sm");
}
