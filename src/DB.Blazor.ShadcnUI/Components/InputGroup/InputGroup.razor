@namespace DB.Blazor.ShadcnUI.Components
@inherits ShadcnComponent

<div role="group" data-slot="input-group" class="@Classes" style="@Style" @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string? Classes => MergeClass("group/input-group cn-input-group relative flex w-full min-w-0 items-center outline-none has-[>textarea]:h-auto");
}

