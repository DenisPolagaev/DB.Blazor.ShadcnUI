@namespace DB.Blazor.ShadcnUI.Components
@inherits ShadcnComponent

<div data-slot="input-otp" class="@ContainerClasses" style="@Style" @attributes="AdditionalAttributes">
    <input type="@Type" inputmode="@InputMode" pattern="@Pattern" autocomplete="one-time-code" maxlength="@Length"
           value="@Current" disabled="@Disabled"
           class="cn-input-otp-input absolute inset-0 h-full w-full cursor-text bg-transparent text-transparent caret-transparent outline-none"
           @oninput="HandleInputAsync" @onfocus="HandleFocus" @onblur="HandleBlur" />
    <CascadingValue Value="this" IsFixed="true">
        @ChildContent
    </CascadingValue>
</div>

@code {
    /// <summary>Input type (<c>text</c>; the mobile keyboard hint follows it).</summary>
    [Parameter] public string Type { get; set; } = "text";

    /// <summary>Validation pattern (input-otp's <c>pattern</c>); characters that do not match are dropped.</summary>
    [Parameter] public string? Pattern { get; set; }

    /// <summary>Container content: slots, groups, separators.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string InputMode => string.Equals(Type, "text", StringComparison.OrdinalIgnoreCase) ? "text" : "numeric";

    private string? ContainerClasses => MergeClass("cn-input-otp relative flex items-center has-disabled:opacity-50");

    private async Task HandleInputAsync(ChangeEventArgs args)
    {
        await SetValueAsync(args.Value?.ToString());
    }

    private void HandleFocus() => SetFocused(true);

    private void HandleBlur() => SetFocused(false);
}

