@namespace DB.Blazor.ShadcnUI.Components
@inherits ShadcnComponent
@implements IDisposable

<div data-slot="input-otp-slot" data-active="@(Owner?.IsActive(Index) == true ? "true" : "false")"
     class="@Classes" style="@Style" @attributes="AdditionalAttributes">
    @Owner?.CharAt(Index)
    @if (Owner?.IsActive(Index) == true)
    {
        <div class="cn-input-otp-caret pointer-events-none absolute inset-0 flex items-center justify-center">
            <div class="cn-input-otp-caret-line"></div>
        </div>
    }
</div>

@code {
    private InputOTP? _owner;

    [CascadingParameter] private InputOTP? Owner { get; set; }

    /// <summary>Zero-based slot index.</summary>
    [Parameter] public int Index { get; set; }

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        _owner = Owner;
        if (_owner is not null)
        {
            _owner.Changed += OnValueChanged;
        }
    }

    private void OnValueChanged() => _ = InvokeAsync(StateHasChanged);

    /// <inheritdoc />
    public void Dispose()
    {
        if (_owner is not null)
        {
            _owner.Changed -= OnValueChanged;
        }

        GC.SuppressFinalize(this);
    }

    private string? Classes => MergeClass("cn-input-otp-slot relative flex items-center justify-center data-[active=true]:z-10");
}

