@namespace DB.Blazor.ShadcnUI.Components

@inherits ShadcnComponent

<h2 data-slot="dialog-title" id="@Root?.TitleId" class="@Classes" style="@Style"
    @attributes="AdditionalAttributes">@ChildContent</h2>

@code {
    [CascadingParameter] private Dialog? Root { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string? Classes => MergeClass("cn-dialog-title cn-font-heading");
}

