@namespace DB.Blazor.ShadcnUI.Components

@inherits ShadcnComponent

<span data-slot="dialog-close" style="display: contents" @onclick="CloseAsync"
      @attributes="AdditionalAttributes">@ChildContent</span>

@code {
    [CascadingParameter] private Dialog? Root { get; set; }

    /// <summary>Content of the close control (usually a <see cref="Button"/>).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private Task CloseAsync() => Root?.CloseAsync() ?? Task.CompletedTask;
}
