@namespace DB.Blazor.ShadcnUI.Components
@inherits ShadcnOverlayBase

@if (Root is { IsVisible: true })
{
    <div data-slot="dialog-portal">
        <div data-slot="dialog-overlay" data-state="@(Root.IsOpen ? "open" : "closed")"
             class="cn-dialog-overlay fixed inset-0 isolate z-50"
             @onclick="CloseAsync"></div>
        <div @ref="_panel" role="dialog" aria-modal="true" tabindex="-1" data-slot="dialog-content"
             data-state="@(Root.IsOpen ? "open" : "closed")" id="@Root.ContentId" aria-labelledby="@Root.TitleId"
             aria-describedby="@Root.DescriptionId" class="@Classes" style="@Style" @attributes="AdditionalAttributes">
            @ChildContent
            @if (ShowCloseButton)
            {
                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSm" data-slot="dialog-close" Class="cn-dialog-close" OnClick="CloseAsync">
                    <XIcon />
                    <span class="sr-only">Close</span>
                </Button>
            }
        </div>
    </div>
}

@code {
    private string? Classes => MergeClass("cn-dialog-content fixed top-1/2 left-1/2 z-50 w-full -translate-x-1/2 -translate-y-1/2 outline-none");
}



