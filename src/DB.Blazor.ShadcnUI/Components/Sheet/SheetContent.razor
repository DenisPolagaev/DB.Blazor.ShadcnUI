@namespace DB.Blazor.ShadcnUI.Components

@inherits ShadcnOverlayBase

@if (Root is { IsVisible: true })
{
    <div data-slot="sheet-portal">
        <div data-slot="sheet-overlay" data-state="@(Root.IsOpen ? "open" : "closed")"
             class="cn-sheet-overlay fixed inset-0 z-50 duration-100 data-open:animate-in data-open:fade-in-0 data-closed:animate-out data-closed:fade-out-0"
             @onclick="CloseAsync"></div>
        <div @ref="_panel" role="dialog" aria-modal="true" tabindex="-1" data-slot="sheet-content"
             data-state="@(Root.IsOpen ? "open" : "closed")" data-side="@Side.ToDataValue()" id="@Root.ContentId"
             aria-labelledby="@Root.TitleId" aria-describedby="@Root.DescriptionId"
             class="@Classes" style="@Style" @attributes="AdditionalAttributes">
            @ChildContent
            @if (ShowCloseButton)
            {
                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSm" data-slot="sheet-close" Class="cn-sheet-close" OnClick="CloseAsync">
                    <XIcon />
                    <span class="sr-only">Close</span>
                </Button>
            }
        </div>
    </div>
}

@code {
    /// <summary>The edge the sheet slides in from; <c>right</c> by default.</summary>
    [Parameter] public SheetSide Side { get; set; } = SheetSide.Right;

    /// <summary>Renders the built-in close button.</summary>
    [Parameter] public bool ShowCloseButton { get; set; } = true;

    private string? Classes => MergeClass("cn-sheet-content data-open:animate-in data-open:fade-in-0 data-[side=bottom]:data-open:slide-in-from-bottom-10 data-[side=left]:data-open:slide-in-from-left-10 data-[side=right]:data-open:slide-in-from-right-10 data-[side=top]:data-open:slide-in-from-top-10 data-closed:animate-out data-closed:fade-out-0 data-[side=bottom]:data-closed:slide-out-to-bottom-10 data-[side=left]:data-closed:slide-out-to-left-10 data-[side=right]:data-closed:slide-out-to-right-10 data-[side=top]:data-closed:slide-out-to-top-10");
}


