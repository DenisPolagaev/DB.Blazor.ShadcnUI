@namespace DB.Blazor.ShadcnUI.Components
@inherits ShadcnComponent

<p data-slot="drawer-description" id="@Root?.DescriptionId" class="@Classes" style="@Style"
   @attributes="AdditionalAttributes">@ChildContent</p>

@code {
    [CascadingParameter] private Drawer? Root { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string? Classes => MergeClass("cn-drawer-description");
}

