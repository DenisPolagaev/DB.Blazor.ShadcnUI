@namespace DB.Blazor.ShadcnUI.Components
@inherits ShadcnComponent

<h2 data-slot="drawer-title" id="@Root?.TitleId" class="@Classes" style="@Style"
    @attributes="AdditionalAttributes">@ChildContent</h2>

@code {
    [CascadingParameter] private Drawer? Root { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string? Classes => MergeClass("cn-drawer-title cn-font-heading");
}

