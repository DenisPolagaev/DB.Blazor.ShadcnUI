@namespace DB.Blazor.ShadcnUI.Components
@inherits ShadcnComponent

<div data-slot="drawer-header" class="@Classes" style="@Style" @attributes="AdditionalAttributes">@ChildContent</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string? Classes => MergeClass("cn-drawer-header flex flex-col group-data-[vaul-drawer-direction=bottom]/drawer-content:text-center group-data-[vaul-drawer-direction=top]/drawer-content:text-center");
}

