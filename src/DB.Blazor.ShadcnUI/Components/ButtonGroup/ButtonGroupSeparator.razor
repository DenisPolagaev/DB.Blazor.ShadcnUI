@namespace DB.Blazor.ShadcnUI.Components
@inherits ShadcnComponent

<Separator data-slot="button-group-separator" Orientation="@Orientation" Class="@Classes" />

@code {
    /// <summary><c>vertical</c> by default, like shadcn.</summary>
    [Parameter] public ShadcnOrientation Orientation { get; set; } = ShadcnOrientation.Vertical;

    private string? Classes => Cx("cn-button-group-separator relative self-stretch data-horizontal:mx-px data-horizontal:w-auto data-vertical:my-px data-vertical:h-auto", Class);
}

