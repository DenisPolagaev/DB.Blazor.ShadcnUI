@namespace DB.Blazor.ShadcnUI.Components

@inherits ShadcnComponent

<input data-slot="input" type="@Type" value="@Value" placeholder="@Placeholder" disabled="@Disabled"
       readonly="@ReadOnly" name="@Name" class="@Classes" style="@Style"
       @oninput="HandleInputAsync" @attributes="AdditionalAttributes" />

@code {
    /// <summary>Native input type, <c>text</c> by default — shadcn's <c>type</c> prop.</summary>
    [Parameter] public string Type { get; set; } = "text";

    /// <summary>Two-way bound value (<c>@bind-Value</c>).</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Value change callback (fires on <c>input</c>, like the browser's live editing).</summary>
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>Expression for validation messages when the input is used inside an <c>EditForm</c>.</summary>
    [Parameter] public System.Linq.Expressions.Expression<Func<string?>>? ValueExpression { get; set; }

    /// <summary>Placeholder text.</summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Native <c>name</c> attribute, for form posts.</summary>
    [Parameter] public string? Name { get; set; }

    /// <summary>Disables the input.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Makes the input read-only.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    private async Task HandleInputAsync(ChangeEventArgs args)
    {
        Value = args.Value?.ToString();
        await ValueChanged.InvokeAsync(Value);
    }

    private string? Classes => MergeClass("cn-input w-full min-w-0 outline-none file:inline-flex file:border-0 file:bg-transparent file:text-foreground placeholder:text-muted-foreground disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50");
}


