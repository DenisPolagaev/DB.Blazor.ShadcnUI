@namespace DB.Blazor.ShadcnUI.Components
@inherits ShadcnDismissableBase

@if (Root is { IsVisible: true })
{
    <div @ref="_panel" role="menu" tabindex="-1" data-slot="menubar-content"
         data-state="@(Root.IsOpen ? "open" : "closed")" id="@Root.ContentId" class="@Classes" style="@Style"
         @attributes="AdditionalAttributes">
        @ChildContent
    </div>
}

@code {
    private string? Classes => MergeClass(
        "bg-popover text-popover-foreground data-[state=open]:animate-in data-[state=closed]:animate-out " +
        "data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0 data-[state=closed]:zoom-out-95 " +
        "data-[state=open]:zoom-in-95 z-50 min-w-[12rem] origin-(--radix-menubar-content-transform-origin) " +
        "overflow-hidden rounded-md border p-1 shadow-md " +
        "data-[side=bottom]:slide-in-from-top-2 data-[side=left]:slide-in-from-right-2 " +
        "data-[side=right]:slide-in-from-left-2 data-[side=top]:slide-in-from-bottom-2");
}
