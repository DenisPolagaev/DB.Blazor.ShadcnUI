@namespace DB.Blazor.ShadcnUI.Components
@inherits ShadcnDismissableBase

@if (Root is { IsVisible: true })
{
    <div @ref="_panel" role="menu" tabindex="-1" data-slot="menubar-content"
         data-state="@(Root.IsOpen ? "open" : "closed")" id="@Root.ContentId" class="@Classes" style="@StyleWith("visibility: hidden")"
         @attributes="AdditionalAttributes">
        @ChildContent
    </div>
}

@code {
    private string? Classes => MergeClass("cn-menubar-content cn-menu-target cn-menu-translucent z-50 origin-(--radix-menubar-content-transform-origin) overflow-hidden data-closed:animate-out data-closed:fade-out-0 data-closed:zoom-out-95");
}



