@namespace DB.Blazor.ShadcnUI.Components
@inherits ShadcnComponent

<button type="button" id="@Root?.TriggerId" role="menuitem" data-slot="menubar-trigger"
        data-state="@(Root?.IsOpen == true ? "open" : "closed")" aria-haspopup="menu"
        aria-expanded="@(Root?.IsOpen == true ? "true" : "false")" aria-controls="@Root?.ContentId"
        class="@Classes" style="@Style" @onclick="ToggleAsync" @onpointerenter="OpenOnHoverAsync"
        @attributes="AdditionalAttributes">@ChildContent</button>

@code {
    [CascadingParameter] private MenubarMenu? Root { get; set; }

    [CascadingParameter] private Menubar? Bar { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private async Task ToggleAsync()
    {
        if (Root is null)
        {
            return;
        }

        if (!Root.IsOpen && Bar is not null)
        {
            await Bar.CloseOthersAsync(Root);
        }

        await Root.ToggleAsync();
    }

    private async Task OpenOnHoverAsync()
    {
        if (Root is null || Root.IsOpen || Bar?.HasOpenMenu != true)
        {
            return;
        }

        await Bar.CloseOthersAsync(Root);
        await Root.ShowAsync();
    }

    private string? Classes => MergeClass("cn-menubar-trigger flex items-center outline-hidden select-none");
}

