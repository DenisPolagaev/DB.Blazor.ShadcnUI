@namespace DB.Blazor.ShadcnUI.Components

@inherits ShadcnComponent

<div data-slot="tabs" data-orientation="@Orientation.ToDataValue()" class="@Classes" style="@Style"
     @attributes="AdditionalAttributes">
    <CascadingValue Value="this" IsFixed="true">
        @ChildContent
    </CascadingValue>
</div>

@code {
    private string? Classes => MergeClass("group/tabs flex gap-2 data-[orientation=horizontal]:flex-col");
}
