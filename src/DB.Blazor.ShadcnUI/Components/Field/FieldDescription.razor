@namespace DB.Blazor.ShadcnUI.Components
@inherits ShadcnComponent

<p data-slot="field-description" class="@Classes" style="@Style" @attributes="AdditionalAttributes">
    @ChildContent
</p>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string? Classes => MergeClass(Cx("cn-field-description leading-normal font-normal group-has-data-horizontal/field:text-balance", "last:mt-0 nth-last-2:-mt-1", "[&>a]:underline [&>a]:underline-offset-4 [&>a:hover]:text-primary"));
}


