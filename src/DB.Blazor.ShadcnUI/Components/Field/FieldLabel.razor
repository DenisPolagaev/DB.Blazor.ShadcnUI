@namespace DB.Blazor.ShadcnUI.Components
@inherits ShadcnComponent

<Label for="@For" data-slot="field-label" Class="@Classes" style="@Style" @attributes="AdditionalAttributes">@ChildContent</Label>

@code {
    /// <summary>Id of the labelled control (<c>for</c>).</summary>
    [Parameter] public string? For { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string? Classes => Cn.Merge(
        "cn-field-label group/field-label peer/field-label flex w-fit",
        "has-[>[data-slot=field]]:w-full has-[>[data-slot=field]]:flex-col",
        Class);
}
