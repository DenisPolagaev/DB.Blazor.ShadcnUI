@namespace DB.Blazor.ShadcnUI.Components
@inherits ShadcnComponent

<div data-slot="aspect-ratio" style="@StyleWith(RatioStyle)" class="@Class" @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    /// <summary>Width / height ratio (Radix <c>ratio</c>, 1 by default).</summary>
    [Parameter] public double Ratio { get; set; } = 1;

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string RatioStyle => $"aspect-ratio: {Ratio.ToString(CultureInfo.InvariantCulture)}";
}
