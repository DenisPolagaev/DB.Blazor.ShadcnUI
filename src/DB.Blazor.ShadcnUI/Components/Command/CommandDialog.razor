@namespace DB.Blazor.ShadcnUI.Components
@inherits ShadcnComponent

<Dialog Open="Open" OpenChanged="OpenChanged" DefaultOpen="DefaultOpen">
    <DialogContent Class="@ContentClasses" ShowCloseButton="ShowCloseButton">
        <DialogHeader Class="sr-only">
            <DialogTitle>@Title</DialogTitle>
            <DialogDescription>@Description</DialogDescription>
        </DialogHeader>
        <DB.Blazor.ShadcnUI.Components.Command>@ChildContent</DB.Blazor.ShadcnUI.Components.Command>
    </DialogContent>
</Dialog>

@code {
    
    /// <summary>Controlled open state (<c>@bind-Open</c>), forwarded to the dialog.</summary>
    [Parameter] public bool Open { get; set; }

    /// <summary>Open change callback.</summary>
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>Initial state of an uncontrolled dialog.</summary>
    [Parameter] public bool DefaultOpen { get; set; }

    /// <summary>The screen-reader title of the palette.</summary>
    [Parameter] public string Title { get; set; } = "Command Palette";

    /// <summary>The screen-reader description of the palette.</summary>
    [Parameter] public string Description { get; set; } = "Search for a command to run...";

    /// <summary>Renders the dialog's close button.</summary>
    [Parameter] public bool ShowCloseButton { get; set; } = false;

    /// <summary>The palette's input, list and item groups.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string? ContentClasses => Cn.Merge("cn-command-dialog top-1/3 translate-y-0 overflow-hidden p-0", Class);
}



