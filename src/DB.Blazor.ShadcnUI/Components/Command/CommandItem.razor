@namespace DB.Blazor.ShadcnUI.Components
@inherits ShadcnComponent

<div data-slot="command-item" cmdk-item role="option" id="@ElementId" tabindex="-1"
     data-value="@Value" data-keywords="@Keywords" data-selected="false" aria-selected="false"
     data-disabled="@(Disabled ? "true" : "false")" aria-disabled="@(Disabled ? "true" : null)"
     class="@Classes" style="@Style" @onclick="HandleClickAsync" @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    /// <summary>The value used for filtering and selection; falls back to the item's text.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Extra search terms, space separated (cmdk's <c>keywords</c>).</summary>
    [Parameter] public string? Keywords { get; set; }

    /// <summary>Disables the item.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Runs when the item is chosen.</summary>
    [Parameter] public EventCallback OnSelect { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private Task HandleClickAsync() => Disabled ? Task.CompletedTask : OnSelect.InvokeAsync();

    private string? Classes => MergeClass(
        "relative flex cursor-default items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-hidden " +
        "select-none data-[disabled=true]:pointer-events-none data-[disabled=true]:opacity-50 " +
        "data-[selected=true]:bg-accent data-[selected=true]:text-accent-foreground " +
        "[&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4 " +
        "[&_svg:not([class*='text-'])]:text-muted-foreground");
}
