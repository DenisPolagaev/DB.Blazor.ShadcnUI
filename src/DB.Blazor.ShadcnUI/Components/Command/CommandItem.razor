@namespace DB.Blazor.ShadcnUI.Components
@inherits ShadcnComponent

<div data-slot="command-item" cmdk-item role="option" id="@ElementId" tabindex="-1"
     data-value="@Value" data-keywords="@Keywords" data-selected="false" aria-selected="false"
     data-disabled="@(Disabled ? "true" : "false")" aria-disabled="@(Disabled ? "true" : null)" data-checked="@(Checked ? "true" : null)"
     class="@Classes" style="@Style" @onclick="HandleClickAsync" @attributes="AdditionalAttributes">
    @ChildContent
    <CheckIcon Class="cn-command-item-indicator ml-auto opacity-0 group-has-data-[slot=command-shortcut]/command-item:hidden group-data-[checked=true]/command-item:opacity-100" />
</div>

@code {
    /// <summary>The value used for filtering and selection; falls back to the item's text.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Extra search terms, space separated (cmdk's <c>keywords</c>).</summary>
    [Parameter] public string? Keywords { get; set; }

    /// <summary>Disables the item.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Marks the item as the chosen one (the trailing check indicator).</summary>
    [Parameter] public bool Checked { get; set; }

    /// <summary>Runs when the item is chosen.</summary>
    [Parameter] public EventCallback OnSelect { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private Task HandleClickAsync() => Disabled ? Task.CompletedTask : OnSelect.InvokeAsync();

    private string? Classes => MergeClass("cn-command-item group/command-item data-[disabled=true]:pointer-events-none data-[disabled=true]:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0");
}


