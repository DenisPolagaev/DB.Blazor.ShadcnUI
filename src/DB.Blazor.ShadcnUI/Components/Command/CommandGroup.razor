@namespace DB.Blazor.ShadcnUI.Components
@inherits ShadcnComponent

<div data-slot="command-group" cmdk-group role="group" aria-labelledby="@(Heading is null ? null : HeadingId)"
     class="@Classes" style="@Style" @attributes="AdditionalAttributes">
    @if (Heading is not null)
    {
        <div cmdk-group-heading id="@HeadingId">@Heading</div>
    }
    @ChildContent
</div>

@code {
    /// <summary>The group heading (cmdk's <c>heading</c>).</summary>
    [Parameter] public string? Heading { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string HeadingId => $"{ElementId}-heading";

    private string? Classes => MergeClass(
        "overflow-hidden p-1 text-foreground [&_[cmdk-group-heading]]:px-2 " +
        "[&_[cmdk-group-heading]]:py-1.5 [&_[cmdk-group-heading]]:text-xs " +
        "[&_[cmdk-group-heading]]:font-medium [&_[cmdk-group-heading]]:text-muted-foreground");
}
