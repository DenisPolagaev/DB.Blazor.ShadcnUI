@namespace DP.ShadcnBlazor.Components

@inherits ShadcnDismissableBase

@if (Root is { IsVisible: true })
{
    <div @ref="_panel" data-slot="tooltip-content" data-state="@(Root.IsOpen ? "open" : "closed")" role="tooltip" id="@Root.ContentId"
         class="@Classes" style="@Style" @attributes="AdditionalAttributes">
        @ChildContent
        <span data-slot="tooltip-arrow"
              class="z-50 size-2.5 translate-y-[calc(-50%_-_2px)] rotate-45 rounded-[2px] bg-foreground fill-foreground"></span>
    </div>
}

@code {
    private string? Classes => MergeClass(
        "z-50 w-fit origin-(--radix-tooltip-content-transform-origin) animate-in rounded-md bg-foreground " +
        "px-3 py-1.5 text-xs text-balance text-background fade-in-0 zoom-in-95 " +
        "data-[side=bottom]:slide-in-from-top-2 data-[side=left]:slide-in-from-right-2 " +
        "data-[side=right]:slide-in-from-left-2 data-[side=top]:slide-in-from-bottom-2 " +
        "data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=closed]:zoom-out-95");
}
