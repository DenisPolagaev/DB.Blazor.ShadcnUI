@namespace DP.ShadcnBlazor.Components

@inherits ShadcnComponent

<h3 data-orientation="vertical" class="flex">
    <button type="button" data-slot="accordion-trigger" data-state="@(Item?.Open == true ? "open" : "closed")"
            aria-expanded="@(Item?.Open == true ? "true" : "false")" aria-controls="@Item?.ContentId"
            id="@Item?.TriggerId" disabled="@(Item?.Disabled ?? false)" class="@Classes" style="@Style"
            @onclick="HandleClickAsync" @attributes="AdditionalAttributes">
        @ChildContent
        <ChevronDownIcon Class="pointer-events-none size-4 shrink-0 translate-y-0.5 text-muted-foreground transition-transform duration-200" />
    </button>
</h3>

@code {
    [CascadingParameter] private AccordionItem? Item { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private Task HandleClickAsync() => Item?.ToggleAsync() ?? Task.CompletedTask;

    private string? Classes => MergeClass(
        "flex flex-1 items-start justify-between gap-4 rounded-md py-4 text-left text-sm font-medium " +
        "transition-all outline-none hover:underline focus-visible:border-ring focus-visible:ring-[3px] " +
        "focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-50 " +
        "[&[data-state=open]>svg]:rotate-180");
}
