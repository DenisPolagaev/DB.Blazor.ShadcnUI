@namespace DP.ShadcnBlazor.Components
@inherits ShadcnComponent
@implements IAsyncDisposable

<div @ref="_panel" data-slot="accordion-content" data-state="@(Item?.Open == true ? "open" : "closed")"
     role="region" aria-labelledby="@Item?.TriggerId" inert="@(Item?.Open != true)" class="overflow-hidden text-sm">
    <div class="@Classes">@ChildContent</div>
</div>

@code {
    [CascadingParameter] private AccordionItem? Item { get; set; }

    [Inject] private IJSRuntime Js { get; set; } = default!;

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private ElementReference _panel;
    private IJSObjectReference? _module;

    private string? Classes => MergeClass("pt-0 pb-4");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            _module ??= await ShadcnJs.ImportAsync(Js);
            await _module.InvokeVoidAsync("syncAccordion", _panel, Item?.Open == true);
        }
        catch (Exception exception) when (exception is JSException or InvalidOperationException or JSDisconnectedException or ObjectDisposedException)
        {
            // Prerender / disconnected circuit: the panel renders collapsed, no measurement.
        }
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (Exception exception) when (exception is JSException or JSDisconnectedException or ObjectDisposedException)
            {
            }
        }
    }
}
