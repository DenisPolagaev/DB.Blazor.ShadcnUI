@namespace DP.ShadcnBlazor.Components

@inherits ShadcnComponent

@if (Href is not null)
{
    <a href="@Href" target="@Target" data-slot="button" data-variant="@Variant.ToDataValue()"
       data-size="@Size.ToDataValue()" class="@Classes" style="@Style" aria-disabled="@(Disabled ? "true" : null)"
       @onclick="OnClick" @attributes="AdditionalAttributes">@ChildContent</a>
}
else
{
    <button type="@Type" data-slot="button" data-variant="@Variant.ToDataValue()" data-size="@Size.ToDataValue()"
            class="@Classes" style="@Style" disabled="@Disabled" @onclick="OnClick"
            @attributes="AdditionalAttributes">@ChildContent</button>
}
