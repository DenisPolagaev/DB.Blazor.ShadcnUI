@namespace DP.ShadcnBlazor.Components

@inherits ShadcnComponent

<div data-slot="card" class="@Classes" style="@Style" @attributes="AdditionalAttributes">@ChildContent</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string? Classes => MergeClass("flex flex-col gap-6 rounded-xl border bg-card py-6 text-card-foreground shadow-sm");
}
