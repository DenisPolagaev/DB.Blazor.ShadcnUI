@namespace DP.ShadcnBlazor.Components

@inherits ShadcnComponent

<span id="@Root?.TriggerId" data-slot="dialog-trigger" style="display: contents" aria-haspopup="dialog"
      aria-expanded="@(Root?.IsOpen == true ? "true" : "false")" @onclick="OpenAsync"
      @attributes="AdditionalAttributes">@ChildContent</span>

@code {
    [CascadingParameter] private Dialog? Root { get; set; }

    /// <summary>The control that opens the dialog (typically a <see cref="Button"/>).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private Task OpenAsync() => Root?.ShowAsync() ?? Task.CompletedTask;
}
