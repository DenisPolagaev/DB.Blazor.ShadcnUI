@namespace DP.ShadcnBlazor.Components

@inherits ShadcnComponent

<div role="tabpanel" data-slot="tabs-content" data-state="@(Active ? "active" : "inactive")"
     id="@Owner?.ContentId(Value)" aria-labelledby="@Owner?.TriggerId(Value)" hidden="@(!Active)"
     class="@Classes" style="@Style" @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    [CascadingParameter] private Tabs? Owner { get; set; }

    /// <summary>The value this panel belongs to.</summary>
    [Parameter] public string? Value { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool Active => Owner?.IsActive(Value) ?? false;

    private string? Classes => MergeClass("flex-1 outline-none");
}
