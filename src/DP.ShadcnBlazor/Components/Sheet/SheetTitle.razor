@namespace DP.ShadcnBlazor.Components

@inherits ShadcnComponent

<h2 data-slot="sheet-title" id="@Root?.TitleId" class="@Classes" style="@Style"
    @attributes="AdditionalAttributes">@ChildContent</h2>

@code {
    [CascadingParameter] private Sheet? Root { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string? Classes => MergeClass("font-semibold text-foreground");
}
