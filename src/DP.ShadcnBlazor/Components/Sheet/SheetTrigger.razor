@namespace DP.ShadcnBlazor.Components

@inherits ShadcnComponent

<span id="@Root?.TriggerId" data-slot="sheet-trigger" style="display: contents" aria-haspopup="dialog"
      aria-expanded="@(Root?.IsOpen == true ? "true" : "false")" @onclick="OpenAsync"
      @attributes="AdditionalAttributes">@ChildContent</span>

@code {
    [CascadingParameter] private Sheet? Root { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private Task OpenAsync() => Root?.ShowAsync() ?? Task.CompletedTask;
}
