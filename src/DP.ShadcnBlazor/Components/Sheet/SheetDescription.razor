@namespace DP.ShadcnBlazor.Components

@inherits ShadcnComponent

<p data-slot="sheet-description" id="@Root?.DescriptionId" class="@Classes" style="@Style"
   @attributes="AdditionalAttributes">@ChildContent</p>

@code {
    [CascadingParameter] private Sheet? Root { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string? Classes => MergeClass("text-sm text-muted-foreground");
}
