@namespace DP.ShadcnBlazor.Components
@inherits ShadcnComponent

@* Radix renders a real scrollbar element it controls from JavaScript. The Blazor port keeps the
   same markup and class list but lets the browser scroll the viewport; the scrollbar element is
   rendered for parity and hidden by the component CSS. *@

<div data-slot="scroll-area" class="@Classes" style="@Style" @attributes="AdditionalAttributes">
    <div data-slot="scroll-area-viewport"
         class="size-full rounded-[inherit] transition-[color,box-shadow] outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 focus-visible:outline-1">
        @ChildContent
    </div>
    @if (ShowScrollBar)
    {
        <ScrollBar Orientation="@Orientation" />
    }
</div>

@code {
    /// <summary>Scrollable content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Renders the (native-backed) scrollbar element, like shadcn does.</summary>
    [Parameter] public bool ShowScrollBar { get; set; } = true;

    /// <summary>Scrollbar orientation.</summary>
    [Parameter] public ShadcnOrientation Orientation { get; set; } = ShadcnOrientation.Vertical;

    private string? Classes => MergeClass("relative");
}
