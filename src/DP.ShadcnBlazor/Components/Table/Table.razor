@namespace DP.ShadcnBlazor.Components

@inherits ShadcnComponent

<div data-slot="table-container" class="@ContainerClasses">
    <table data-slot="table" class="@Classes" style="@Style" @attributes="AdditionalAttributes">@ChildContent</table>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Extra classes for the scroll container (the table itself receives <c>class</c>).</summary>
    [Parameter] public string? ContainerClass { get; set; }

    private string? ContainerClasses => Cx("relative w-full overflow-x-auto", ContainerClass);

    private string? Classes => MergeClass("w-full caption-bottom text-sm");
}
