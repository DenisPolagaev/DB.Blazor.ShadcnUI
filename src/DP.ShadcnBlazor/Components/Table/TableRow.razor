@namespace DP.ShadcnBlazor.Components

@inherits ShadcnComponent

<tr data-slot="table-row" data-state="@SelectedState" class="@Classes" style="@Style" @attributes="AdditionalAttributes">@ChildContent</tr>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Radix <c>data-state="selected"</c>; the row paints <c>bg-muted</c> when set.</summary>
    [Parameter] public bool Selected { get; set; }

    private string? SelectedState => Selected ? "selected" : null;

    private string? Classes => MergeClass(
        "border-b transition-colors hover:bg-muted/50 has-aria-expanded:bg-muted/50 data-[state=selected]:bg-muted");
}
