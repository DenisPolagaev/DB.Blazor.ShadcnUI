@namespace DP.ShadcnBlazor.Components

@inherits ShadcnDismissableBase

@if (Owner is { IsOpen: true })
{
    <div @ref="_panel" role="menu" tabindex="-1" data-slot="dropdown-menu-sub-content" data-state="open"
         id="@Owner.ContentId" aria-labelledby="@Owner.TriggerId" class="@Classes" style="@Style"
         @onpointerenter="CancelClose" @onpointerleave="ScheduleClose" @attributes="AdditionalAttributes">
        @ChildContent
    </div>
}

@code {
    private string? Classes => MergeClass(
        "z-50 min-w-[8rem] origin-(--radix-dropdown-menu-content-transform-origin) overflow-hidden rounded-md " +
        "border bg-popover p-1 text-popover-foreground shadow-lg data-[side=bottom]:slide-in-from-top-2 " +
        "data-[side=left]:slide-in-from-right-2 data-[side=right]:slide-in-from-left-2 " +
        "data-[side=top]:slide-in-from-bottom-2 data-[state=closed]:animate-out " +
        "data-[state=closed]:fade-out-0 data-[state=closed]:zoom-out-95 data-[state=open]:animate-in " +
        "data-[state=open]:fade-in-0 data-[state=open]:zoom-in-95");
}
