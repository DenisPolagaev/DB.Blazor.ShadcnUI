<Project>

  <ItemGroup Label="Library (component assemblies for both target frameworks)">
    <!-- The lowest supported TFM's version: a net11.0 host loads the shared framework's 11.0
         assemblies at runtime, while a browser-wasm build of a net10.0 app resolves exactly these.
         This is why the library references the package instead of
         <FrameworkReference Include="Microsoft.AspNetCore.App" /> — that framework has no
         browser-wasm runtime pack (NETSDK1082). -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="bunit" Version="2.15.2" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup Label="Demo (the sample hosts both render modes on net10.0)">
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.15" />
  </ItemGroup>

</Project>
