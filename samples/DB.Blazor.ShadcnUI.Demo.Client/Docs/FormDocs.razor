else if (Slug == "radio-group")
{
    <DocPage Title="Radio Group"
             Description="A set of checkable buttons — known as radio buttons — where no more than one can be checked at a time."
             Code="@RadioGroupCode" Usage="@RadioGroupUsage">
        <Preview>
            <RadioGroup Value="comfortable">
                <div class="demo-row">
                    <RadioGroupItem Value="default" id="r1" />
                    <Label For="r1">Default</Label>
                </div>
                <div class="demo-row">
                    <RadioGroupItem Value="comfortable" id="r2" />
                    <Label For="r2">Comfortable</Label>
                </div>
                <div class="demo-row">
                    <RadioGroupItem Value="compact" id="r3" />
                    <Label For="r3">Compact</Label>
                </div>
            </RadioGroup>
        </Preview>
        <Examples>
            <h3 class="docs-example-title">Description</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <RadioGroup Value="comfortable">
                    <Field Orientation="FieldOrientation.Horizontal">
                        <RadioGroupItem Value="default" id="r-desc-1" />
                        <FieldContent>
                            <FieldLabel For="r-desc-1">Default</FieldLabel>
                            <FieldDescription>The default spacing.</FieldDescription>
