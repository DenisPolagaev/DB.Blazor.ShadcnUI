                <RadioGroup Value="default" Disabled="true">
                    <div class="demo-row">
                        <RadioGroupItem Value="default" id="r-dis-1" />
                        <Label For="r-dis-1">Default</Label>
                    </div>
                    <div class="demo-row">
                        <RadioGroupItem Value="comfortable" id="r-dis-2" />
                        <Label For="r-dis-2">Comfortable</Label>
                    </div>
                </RadioGroup>
            </div></div>

            <h3 class="docs-example-title">Invalid</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <FieldSet data-invalid="true" aria-invalid="true" Class="max-w-sm">
                    <FieldLegend Variant="FieldLegendVariant.Label">Choose a density</FieldLegend>
                    <RadioGroup Value="default">
                        <div class="demo-row">
                            <RadioGroupItem Value="default" id="r-inv-1" aria-invalid="true" />
                            <Label For="r-inv-1">Default</Label>
                        </div>
                        <div class="demo-row">
                            <RadioGroupItem Value="comfortable" id="r-inv-2" aria-invalid="true" />
                            <Label For="r-inv-2">Comfortable</Label>
                        </div>
                    </RadioGroup>
                    <FieldError>Please choose a density.</FieldError>
                </FieldSet>
            </div></div>
        </Examples>
    </DocPage>
}
else if (Slug == "native-select")
{
    <DocPage Title="Native Select"
             Description="A native select element with a custom chevron and consistent styling."
             Code="@NativeSelectCode" Usage="@NativeSelectUsage">
        <Preview>
            <NativeSelect Value="apple">
                <NativeSelectOption Value="apple">Apple</NativeSelectOption>
                <NativeSelectOption Value="banana">Banana</NativeSelectOption>
                <NativeSelectOption Value="blueberry">Blueberry</NativeSelectOption>
                <NativeSelectOption Value="grapes">Grapes</NativeSelectOption>
            </NativeSelect>
        </Preview>
        <Examples>
            <h3 class="docs-example-title">Small</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <NativeSelect Size="NativeSelectSize.Sm" Value="apple">
                    <NativeSelectOption Value="apple">Apple</NativeSelectOption>
                    <NativeSelectOption Value="banana">Banana</NativeSelectOption>
                </NativeSelect>
            </div></div>

            <h3 class="docs-example-title">Groups</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <NativeSelect Value="apple">
                    <NativeSelectOptGroup Label="Fruits">
                        <NativeSelectOption Value="apple">Apple</NativeSelectOption>
                        <NativeSelectOption Value="banana">Banana</NativeSelectOption>
                    </NativeSelectOptGroup>
                    <NativeSelectOptGroup Label="Vegetables">
                        <NativeSelectOption Value="carrot">Carrot</NativeSelectOption>
                        <NativeSelectOption Value="potato">Potato</NativeSelectOption>
                    </NativeSelectOptGroup>
                </NativeSelect>
            </div></div>

            <h3 class="docs-example-title">Disabled</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <NativeSelect Disabled="true" Value="apple">
                    <NativeSelectOption Value="apple">Apple</NativeSelectOption>
                    <NativeSelectOption Value="banana">Banana</NativeSelectOption>
                </NativeSelect>
            </div></div>

            <h3 class="docs-example-title">Invalid</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <Field data-invalid="true" Class="max-w-xs">
                    <FieldLabel For="native-select-invalid">Fruit</FieldLabel>
                    <NativeSelect id="native-select-invalid" aria-invalid="true">
                        <NativeSelectOption Value="">Select a fruit</NativeSelectOption>
                        <NativeSelectOption Value="apple">Apple</NativeSelectOption>
                        <NativeSelectOption Value="banana">Banana</NativeSelectOption>
                    </NativeSelect>
                    <FieldError>Please select a fruit.</FieldError>
                </Field>
            </div></div>
        </Examples>
    </DocPage>
}
else if (Slug == "select")
{
    <DocPage Title="Select"
             Description="Displays a list of options for the user to pick from, triggered by a button."
             Code="@SelectCode" Usage="@SelectUsage">
        <Preview>
            <Select DefaultValue="apple">
                <SelectTrigger Class="w-[180px]">
                    <SelectValue Placeholder="Select a fruit" />
                </SelectTrigger>
                <SelectContent>
                    <SelectGroup>
                        <SelectLabel>Fruits</SelectLabel>
                        <SelectItem Value="apple">Apple</SelectItem>
                        <SelectItem Value="banana">Banana</SelectItem>
                        <SelectItem Value="blueberry">Blueberry</SelectItem>
                        <SelectItem Value="grapes">Grapes</SelectItem>
                        <SelectItem Value="pineapple">Pineapple</SelectItem>
                    </SelectGroup>
                </SelectContent>
            </Select>
        </Preview>
        <Examples>
            <h3 class="docs-example-title">Align Item With Trigger</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <FieldGroup Class="w-full max-w-xs">
                    <Field Orientation="FieldOrientation.Horizontal">
                        <FieldContent>
                            <FieldLabel For="select-align-item">Align Item</FieldLabel>
                            <FieldDescription>Toggle to align the item with the trigger.</FieldDescription>
                        </FieldContent>
                        <Switch id="select-align-item" @bind-Checked="_alignItemWithTrigger" />
                    </Field>
                    <Field>
                        <Select DefaultValue="banana">
                            <SelectTrigger>
                                <SelectValue />
                            </SelectTrigger>
                            <SelectContent Position="@(_alignItemWithTrigger ? SelectPosition.ItemAligned : SelectPosition.Popper)">
                                <SelectGroup>
                                    <SelectItem Value="apple">Apple</SelectItem>
                                    <SelectItem Value="banana">Banana</SelectItem>
                                    <SelectItem Value="blueberry">Blueberry</SelectItem>
                                    <SelectItem Value="grapes">Grapes</SelectItem>
                                    <SelectItem Value="pineapple">Pineapple</SelectItem>
                                </SelectGroup>
                            </SelectContent>
                        </Select>
                    </Field>
                </FieldGroup>
            </div></div>
            <h3 class="docs-example-title">Small</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <Select DefaultValue="apple">
                    <SelectTrigger Size="SelectSize.Sm" Class="w-[180px]">
                        <SelectValue Placeholder="Select a fruit" />
                    </SelectTrigger>
                    <SelectContent>
                        <SelectItem Value="apple">Apple</SelectItem>
                        <SelectItem Value="banana">Banana</SelectItem>
                        <SelectItem Value="blueberry">Blueberry</SelectItem>
                    </SelectContent>
                </Select>
            </div></div>

            <h3 class="docs-example-title">With groups and separator</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <Select DefaultValue="apple">
                    <SelectTrigger Class="w-[180px]">
                        <SelectValue Placeholder="Select a fruit" />
                    </SelectTrigger>
                    <SelectContent>
                        <SelectGroup>
                            <SelectLabel>Fruits</SelectLabel>
                            <SelectItem Value="apple">Apple</SelectItem>
                            <SelectItem Value="banana">Banana</SelectItem>
                            <SelectItem Value="blueberry">Blueberry</SelectItem>
                        </SelectGroup>
                        <SelectSeparator />
                        <SelectGroup>
                            <SelectLabel>Vegetables</SelectLabel>
                            <SelectItem Value="carrot">Carrot</SelectItem>
                            <SelectItem Value="potato">Potato</SelectItem>
                        </SelectGroup>
                    </SelectContent>
                </Select>
            </div></div>

            <h3 class="docs-example-title">Disabled</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <Select Disabled="true">
                    <SelectTrigger Class="w-[180px]">
                        <SelectValue Placeholder="Select a fruit" />
                    </SelectTrigger>
                    <SelectContent>
                        <SelectItem Value="apple">Apple</SelectItem>
                    </SelectContent>
                </Select>
            </div></div>

            <h3 class="docs-example-title">Scrollable</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <Select>
                    <SelectTrigger Class="w-[180px]">
                        <SelectValue Placeholder="Select a timezone" />
                    </SelectTrigger>
                    <SelectContent Class="max-h-64">
                        <SelectItem Value="est">Eastern Standard Time (EST)</SelectItem>
                        <SelectItem Value="cst">Central Standard Time (CST)</SelectItem>
                        <SelectItem Value="mst">Mountain Standard Time (MST)</SelectItem>
                        <SelectItem Value="pst">Pacific Standard Time (PST)</SelectItem>
                        <SelectItem Value="akst">Alaska Standard Time (AKST)</SelectItem>
                        <SelectItem Value="hst">Hawaii Standard Time (HST)</SelectItem>
                        <SelectItem Value="gmt">Greenwich Mean Time (GMT)</SelectItem>
                        <SelectItem Value="cet">Central European Time (CET)</SelectItem>
                        <SelectItem Value="eet">Eastern European Time (EET)</SelectItem>
                        <SelectItem Value="ist">India Standard Time (IST)</SelectItem>
                        <SelectItem Value="jst">Japan Standard Time (JST)</SelectItem>
                        <SelectItem Value="aest">Australian Eastern Standard Time (AEST)</SelectItem>
                    </SelectContent>
                </Select>
            </div></div>

            <h3 class="docs-example-title">Invalid</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <Field data-invalid="true" Class="w-full max-w-48">
                    <FieldLabel For="select-invalid">Fruit</FieldLabel>
                    <Select>
                        <SelectTrigger id="select-invalid" aria-invalid="true">
                            <SelectValue Placeholder="Select a fruit" />
                        </SelectTrigger>
                        <SelectContent>
                            <SelectGroup>
                                <SelectItem Value="apple">Apple</SelectItem>
                                <SelectItem Value="banana">Banana</SelectItem>
                                <SelectItem Value="blueberry">Blueberry</SelectItem>
                            </SelectGroup>
                        </SelectContent>
                    </Select>
                    <FieldError>Please select a fruit.</FieldError>
                </Field>
            </div></div>
        </Examples>
    </DocPage>
}

