@namespace DB.Blazor.ShadcnUI.Demo.Client.Docs

@if (Slug == "input")
{
    <DocPage Title="Input" Description="Displays a form input field or a component that looks like an input field."
             Code="@InputCode" Usage="@InputUsage">
        <Preview>
            <Input Type="email" Placeholder="Email" Class="max-w-sm" />
        </Preview>
        <Examples>
            <h3 class="docs-example-title">With label</h3>
            <div class="docs-preview"><div class="docs-preview-body" style="align-items: stretch">
                <div class="demo-form" style="max-width: 320px; margin: 0 auto; width: 100%">
                    <Label For="input-email">Email</Label>
                    <Input id="input-email" Type="email" Placeholder="Email" />
                </div>
            </div></div>

            <h3 class="docs-example-title">Disabled</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <Input Disabled="true" Placeholder="Email" Class="max-w-sm" />
            </div></div>

            <h3 class="docs-example-title">File</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <Input Type="file" Class="max-w-sm" />
            </div></div>

            <h3 class="docs-example-title">Field</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <Field Class="max-w-sm">
                    <FieldLabel For="input-field-email">Email</FieldLabel>
                    <Input id="input-field-email" Type="email" Placeholder="Email" />
                    <FieldDescription>We'll never share your email.</FieldDescription>
                </Field>
            </div></div>

            <h3 class="docs-example-title">Invalid</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <Field data-invalid="true" Class="max-w-sm">
                    <FieldLabel For="input-invalid-email">Email</FieldLabel>
                    <Input id="input-invalid-email" Type="email" Placeholder="Email" aria-invalid="true" />
                    <FieldError>Please enter a valid email address.</FieldError>
                </Field>
            </div></div>

            <h3 class="docs-example-title">Inline</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <InputGroup Class="max-w-sm">
                    <InputGroupInput Placeholder="Search..." />
                    <InputGroupAddon Align="InputGroupAlign.InlineEnd">
                        <Kbd>⌘K</Kbd>
                    </InputGroupAddon>
                </InputGroup>
            </div></div>

            <h3 class="docs-example-title">Grid</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <div class="grid w-full max-w-sm grid-cols-2 gap-4">
                    <Input Placeholder="First name" />
                    <Input Placeholder="Last name" />
                    <Input Class="col-span-2" Type="email" Placeholder="Email" />
                </div>
            </div></div>
        </Examples>
    </DocPage>
}
else if (Slug == "textarea")
{
    <DocPage Title="Textarea" Description="Displays a form textarea or a component that looks like a textarea."
             Code="@TextareaCode" Usage="@TextareaUsage">
        <Preview>
            <Textarea Placeholder="Type your message here." Class="max-w-sm" />
        </Preview>
        <Examples>
            <h3 class="docs-example-title">Field</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <Field Class="w-full max-w-sm">
                    <FieldLabel For="textarea-field">Message</FieldLabel>
                    <Textarea id="textarea-field" Placeholder="Type your message here." />
                    <FieldDescription>Your message will be copied to the support team.</FieldDescription>
                </Field>
            </div></div>

            <h3 class="docs-example-title">Invalid</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <Field data-invalid="true" Class="w-full max-w-sm">
                    <FieldLabel For="textarea-invalid">Message</FieldLabel>
                    <Textarea id="textarea-invalid" Placeholder="Type your message here." aria-invalid="true" />
                    <FieldError>Message must be at least 20 characters.</FieldError>
                </Field>
            </div></div>

            <h3 class="docs-example-title">Button</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <div class="grid w-full max-w-sm gap-2">
                    <Textarea Placeholder="Type your message here." />
                    <Button Class="w-full">Send message</Button>
                </div>
            </div></div>

            <h3 class="docs-example-title">Disabled</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <Textarea Disabled="true" Placeholder="Type your message here." Class="max-w-sm" />
            </div></div>
        </Examples>
    </DocPage>
}
else if (Slug == "label")
{
    <DocPage Title="Label" Description="Renders an accessible label associated with controls."
             Code="@LabelCode" Usage="@LabelUsage">
        <Preview>
            <div class="demo-row">
                <Checkbox id="label-terms" />
                <Label For="label-terms">Accept terms and conditions</Label>
            </div>
        </Preview>
        <Examples>
            <h3 class="docs-example-title">Label in Field</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <Field Class="w-full max-w-sm">
                    <FieldLabel For="label-field-email">Email</FieldLabel>
                    <Input id="label-field-email" Type="email" Placeholder="Email" />
                    <FieldDescription>We'll never share your email.</FieldDescription>
                </Field>
            </div></div>
        </Examples>
    </DocPage>
}
else if (Slug == "checkbox")
{
    <DocPage Title="Checkbox" Description="A control that allows the user to toggle between checked and not checked."
             Code="@CheckboxCode" Usage="@CheckboxUsage">
        <Preview>
            <div class="demo-row">
                <Checkbox id="terms" />
                <Label For="terms">Accept terms and conditions</Label>
            </div>
        </Preview>
        <Examples>
            <h3 class="docs-example-title">With text</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <div class="demo-row" style="align-items: flex-start; max-width: 380px">
                    <Checkbox id="terms-2" Checked="true" />
                    <div>
                        <Label For="terms-2">Accept terms and conditions</Label>
                        <p class="demo-item-text" style="margin: 4px 0 0">
                            By clicking this checkbox, you agree to the terms and conditions.
                        </p>
                    </div>
                </div>
            </div></div>

            <h3 class="docs-example-title">Checked State</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <div class="demo-row">
                    <Checkbox id="checked-state" Checked="true" />
                    <Label For="checked-state">Accept terms and conditions</Label>
                </div>
            </div></div>

            <h3 class="docs-example-title">Description</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <Field Orientation="FieldOrientation.Horizontal" Class="max-w-sm">
                    <Checkbox id="checkbox-description" />
                    <FieldContent>
                        <FieldLabel For="checkbox-description">Accept terms and conditions</FieldLabel>
                        <FieldDescription>You agree to our Terms of Service and Privacy Policy.</FieldDescription>
                    </FieldContent>
                </Field>
            </div></div>

            <h3 class="docs-example-title">Group</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <FieldSet Class="max-w-sm">
                    <FieldLegend Variant="FieldLegendVariant.Label">Show these items on the desktop:</FieldLegend>
                    <FieldGroup>
                        <Field Orientation="FieldOrientation.Horizontal">
                            <Checkbox id="group-hard-disks" />
                            <FieldLabel For="group-hard-disks">Hard disks</FieldLabel>
                        </Field>
                        <Field Orientation="FieldOrientation.Horizontal">
                            <Checkbox id="group-external-disks" />
                            <FieldLabel For="group-external-disks">External disks</FieldLabel>
                        </Field>
                    </FieldGroup>
                </FieldSet>
            </div></div>

            <h3 class="docs-example-title">Table</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <Table>
                    <TableHeader>
                        <TableRow>
                            <TableHead Class="w-8">
                                <Checkbox aria-label="Select all" />
                            </TableHead>
                            <TableHead>Name</TableHead>
                            <TableHead>Status</TableHead>
                        </TableRow>
                    </TableHeader>
                    <TableBody>
                        <TableRow>
                            <TableCell><Checkbox aria-label="Select row" /></TableCell>
                            <TableCell>Alice Johnson</TableCell>
                            <TableCell>Active</TableCell>
                        </TableRow>
                        <TableRow>
                            <TableCell><Checkbox aria-label="Select row" /></TableCell>
                            <TableCell>Bob Smith</TableCell>
                            <TableCell>Inactive</TableCell>
                        </TableRow>
                    </TableBody>
                </Table>
            </div></div>

            <h3 class="docs-example-title">Invalid</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <Field data-invalid="true" Class="max-w-sm">
                    <div class="demo-row">
                        <Checkbox id="checkbox-invalid" aria-invalid="true" />
                        <Label For="checkbox-invalid">Accept terms and conditions</Label>
                    </div>
                    <FieldError>You must accept the terms to continue.</FieldError>
                </Field>
            </div></div>

            <h3 class="docs-example-title">Disabled</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <div class="demo-row">
                    <Checkbox Disabled="true" id="disabled-checkbox" />
                    <Label For="disabled-checkbox">Enable notifications</Label>
                </div>
            </div></div>
        </Examples>
    </DocPage>
}
else if (Slug == "switch")
{
    <DocPage Title="Switch" Description="A control that allows the user to toggle between checked and not checked."
