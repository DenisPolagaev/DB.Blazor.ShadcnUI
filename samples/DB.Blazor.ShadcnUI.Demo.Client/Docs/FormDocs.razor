                <RadioGroup Value="default">
                    <Field Orientation="FieldOrientation.Horizontal" Class="rounded-lg border p-3">
                        <RadioGroupItem Value="default" id="r-card-1" />
                        <FieldContent>
                            <FieldLabel For="r-card-1">Default</FieldLabel>
                            <FieldDescription>The default spacing.</FieldDescription>
                        </FieldContent>
                    </Field>
                    <Field Orientation="FieldOrientation.Horizontal" Class="rounded-lg border p-3">
                        <RadioGroupItem Value="comfortable" id="r-card-2" />
                        <FieldContent>
                            <FieldLabel For="r-card-2">Comfortable</FieldLabel>
                            <FieldDescription>A roomier layout.</FieldDescription>
                        </FieldContent>
                    </Field>
                </RadioGroup>
            </div></div>

            <h3 class="docs-example-title">Fieldset</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <FieldSet Class="max-w-sm">
                    <FieldLegend Variant="FieldLegendVariant.Label">Choose a density</FieldLegend>
                    <RadioGroup Value="comfortable">
                        <Field Orientation="FieldOrientation.Horizontal">
                            <RadioGroupItem Value="default" id="r-set-1" />
                            <FieldLabel For="r-set-1">Default</FieldLabel>
                        </Field>
                        <Field Orientation="FieldOrientation.Horizontal">
                            <RadioGroupItem Value="comfortable" id="r-set-2" />
                            <FieldLabel For="r-set-2">Comfortable</FieldLabel>
                        </Field>
