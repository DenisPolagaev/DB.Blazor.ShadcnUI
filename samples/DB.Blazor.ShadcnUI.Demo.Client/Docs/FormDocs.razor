            <h3 class="docs-example-title">Choice Card</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <Field Orientation="FieldOrientation.Horizontal" Class="max-w-sm rounded-lg border p-3">
                    <Switch id="switch-choice" />
                    <FieldContent>
                        <FieldLabel For="switch-choice">Share across devices</FieldLabel>
                        <FieldDescription>Focus is shared across devices, and turns the switch on.</FieldDescription>
                    </FieldContent>
                </Field>
            </div></div>

            <h3 class="docs-example-title">Disabled</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <div class="demo-row">
                    <Switch id="switch-disabled" Disabled="true" />
                    <Label For="switch-disabled">Airplane Mode</Label>
                </div>
            </div></div>

            <h3 class="docs-example-title">Invalid</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <Field data-invalid="true" Class="max-w-sm">
                    <div class="demo-row">
                        <Switch id="switch-invalid" aria-invalid="true" />
                        <Label For="switch-invalid">Airplane Mode</Label>
                    </div>
                    <FieldError>You must enable airplane mode to continue.</FieldError>
