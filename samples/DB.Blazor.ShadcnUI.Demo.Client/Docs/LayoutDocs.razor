@namespace DB.Blazor.ShadcnUI.Demo.Client.Docs
@inject DB.Blazor.ShadcnUI.Components.ToastService Toasts

@if (Slug == "aspect-ratio")
{
    <DocPage Title="Aspect Ratio" Description="Displays content within a desired ratio."
             Code="@AspectCode" Usage="@AspectUsage">
        <Preview>
            <div style="width: 100%; max-width: 420px">
                <AspectRatio Ratio="16.0 / 9.0" Class="overflow-hidden rounded-lg bg-muted">
                    <div class="demo-row" style="height: 100%; align-items: center; justify-content: center">
                        <span class="demo-item-text">16 : 9</span>
                    </div>
                </AspectRatio>
            </div>
        </Preview>
        <Examples>
            <h3 class="docs-example-title">Square</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <AspectRatio Ratio="1" Class="w-40 rounded-lg bg-muted">
                    <div class="demo-row" style="height: 100%; align-items: center; justify-content: center">
                        <span class="demo-item-text">1 : 1</span>
                    </div>
                </AspectRatio>
            </div></div>

            <h3 class="docs-example-title">Portrait</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <AspectRatio Ratio="3.0 / 4.0" Class="w-40 rounded-lg bg-muted">
                    <div class="demo-row" style="height: 100%; align-items: center; justify-content: center">
                        <span class="demo-item-text">3 : 4</span>
                    </div>
                </AspectRatio>
            </div></div>
        </Examples>
    </DocPage>
}
else if (Slug == "toggle")
{
    <DocPage Title="Toggle" Description="A two-state button that can be either on or off."
             Code="@ToggleCode" Usage="@ToggleUsage">
        <Preview>
            <Toggle aria-label="Toggle bookmark">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2Z" />
                </svg>
            </Toggle>
        </Preview>
        <Examples>
            <h3 class="docs-example-title">With Text</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <Toggle aria-label="Toggle italic">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M19 4h-9M14 20H5M15 4 9 20" />
                    </svg>
                    Italic
                </Toggle>
            </div></div>

            <h3 class="docs-example-title">Outline</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <Toggle Variant="ToggleVariant.Outline" aria-label="Toggle italic">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M19 4h-9M14 20H5M15 4 9 20" />
                    </svg>
                </Toggle>
            </div></div>

            <h3 class="docs-example-title">Size</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <Toggle Size="ToggleSize.Sm" aria-label="Toggle small">Sm</Toggle>
                <Toggle aria-label="Toggle default">Default</Toggle>
                <Toggle Size="ToggleSize.Lg" aria-label="Toggle large">Lg</Toggle>
            </div></div>

            <h3 class="docs-example-title">Disabled</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <Toggle Disabled="true">Underline</Toggle>
            </div></div>
        </Examples>
    </DocPage>
}
else if (Slug == "toggle-group")
{
    <DocPage Title="Toggle Group" Description="A set of two-state buttons that can be toggled on or off."
             Code="@ToggleGroupCode" Usage="@ToggleGroupUsage">
        <Preview>
            <ToggleGroup Type="ToggleGroupType.Single" DefaultValue="center">
                <ToggleGroupItem Value="left" aria-label="Align left">Left</ToggleGroupItem>
                <ToggleGroupItem Value="center" aria-label="Align center">Center</ToggleGroupItem>
                <ToggleGroupItem Value="right" aria-label="Align right">Right</ToggleGroupItem>
            </ToggleGroup>
        </Preview>
        <Examples>
            <h3 class="docs-example-title">Outline with spacing</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <ToggleGroup Type="ToggleGroupType.Single" Variant="ToggleVariant.Outline" Spacing="1" DefaultValue="bold">
                    <ToggleGroupItem Value="bold" aria-label="Bold">Bold</ToggleGroupItem>
                    <ToggleGroupItem Value="italic" aria-label="Italic">Italic</ToggleGroupItem>
                    <ToggleGroupItem Value="underline" aria-label="Underline">Underline</ToggleGroupItem>
                </ToggleGroup>
            </div></div>

            <h3 class="docs-example-title">Size</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <ToggleGroup Type="ToggleGroupType.Single" Size="ToggleSize.Sm" DefaultValue="left">
                    <ToggleGroupItem Value="left" aria-label="Left">Left</ToggleGroupItem>
                    <ToggleGroupItem Value="center" aria-label="Center">Center</ToggleGroupItem>
                </ToggleGroup>
                <ToggleGroup Type="ToggleGroupType.Single" Size="ToggleSize.Lg" DefaultValue="left">
                    <ToggleGroupItem Value="left" aria-label="Left">Left</ToggleGroupItem>
                    <ToggleGroupItem Value="center" aria-label="Center">Center</ToggleGroupItem>
                </ToggleGroup>
            </div></div>

            <h3 class="docs-example-title">Vertical</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <ToggleGroup Type="ToggleGroupType.Multiple" Orientation="ShadcnOrientation.Vertical" Spacing="1"
                             DefaultValues="@(new[] { "bold", "italic" })">
                    <ToggleGroupItem Value="bold" aria-label="Bold">Bold</ToggleGroupItem>
                    <ToggleGroupItem Value="italic" aria-label="Italic">Italic</ToggleGroupItem>
                    <ToggleGroupItem Value="underline" aria-label="Underline">Underline</ToggleGroupItem>
                </ToggleGroup>
            </div></div>

            <h3 class="docs-example-title">Disabled</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <ToggleGroup Type="ToggleGroupType.Single" Disabled="true" DefaultValue="center">
                    <ToggleGroupItem Value="left" aria-label="Left">Left</ToggleGroupItem>
                    <ToggleGroupItem Value="center" aria-label="Center">Center</ToggleGroupItem>
                    <ToggleGroupItem Value="right" aria-label="Right">Right</ToggleGroupItem>
                </ToggleGroup>
            </div></div>
        </Examples>
    </DocPage>
}
else if (Slug == "collapsible")
{
    <DocPage Title="Collapsible" Description="An interactive component which expands/collapses a panel."
             Code="@CollapsibleCode" Usage="@CollapsibleUsage">
        <Preview>
            <div class="demo-stack" style="width: 100%; max-width: 360px">
                <div class="demo-row" style="justify-content: space-between">
                    <span class="demo-item-title">@(collapsibleOpen ? "3 repositories starred" : "1 repository starred")</span>
                    <Collapsible Open="@collapsibleOpen" OpenChanged="@(value => collapsibleOpen = value)">
                        <CollapsibleTrigger>
                            <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm">Toggle</Button>
                        </CollapsibleTrigger>
                        <CollapsibleContent>
                            <div class="demo-stack" style="margin-top: 8px">
                                <div class="demo-repo">radix-ui/primitives</div>
                                <div class="demo-repo">radix-ui/colors</div>
                                <div class="demo-repo">radix-ui/icons</div>
                            </div>
                        </CollapsibleContent>
                    </Collapsible>
                </div>
                <div class="demo-repo">radix-ui/react</div>
            </div>
        </Preview>
        <Examples>
            <h3 class="docs-example-title">Basic</h3>
            <div class="docs-preview"><div class="docs-preview-body" style="align-items: stretch">
                <Collapsible>
                    <CollapsibleTrigger>
                        <Button Variant="ButtonVariant.Ghost">Can I use this in my project?</Button>
                    </CollapsibleTrigger>
                    <CollapsibleContent>
                        <div class="rounded-md border px-4 py-2">
                            Yes. Free to use for personal and commercial projects.
                        </div>
                    </CollapsibleContent>
                </Collapsible>
            </div></div>

            <h3 class="docs-example-title">Settings Panel</h3>
            <div class="docs-preview"><div class="docs-preview-body" style="align-items: stretch">
                <Collapsible Open="true" Class="w-full max-w-sm rounded-md border p-4">
                    <div class="demo-row" style="justify-content: space-between">
                        <span class="demo-item-title">Restore defaults</span>
                        <CollapsibleTrigger>
                            <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm">Toggle</Button>
                        </CollapsibleTrigger>
                    </div>
                    <CollapsibleContent>
                        <div class="demo-stack" style="margin-top: 12px; gap: 8px">
                            <div class="demo-row"><Checkbox id="collapsible-setting" Checked="true" /><Label For="collapsible-setting">Enable notifications</Label></div>
                            <div class="demo-row"><Checkbox id="collapsible-setting-2" /><Label For="collapsible-setting-2">Auto-update</Label></div>
                        </div>
                    </CollapsibleContent>
                </Collapsible>
            </div></div>
        </Examples>
    </DocPage>
}
else if (Slug == "scroll-area")
{
    <DocPage Title="Scroll Area" Description="Augments native scroll functionality for custom, cross-browser styling."
             Code="@ScrollCode" Usage="@ScrollUsage">
        <Preview>
            <div style="width: 100%; max-width: 420px">
                <ScrollArea Class="h-56 w-full rounded-md border">
                    <div class="demo-stack" style="padding: 16px">
                        @for (var i = 1; i <= 12; i++)
                        {
                            <div class="demo-item-title">Item @i</div>
                            <Separator />
                        }
                    </div>
                </ScrollArea>
            </div>
        </Preview>
        <Examples>
            <h3 class="docs-example-title">Horizontal</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <ScrollArea Orientation="ShadcnOrientation.Horizontal" Class="w-full max-w-sm rounded-md border whitespace-nowrap">
                    <div class="flex gap-4 p-4">
                        @for (var i = 1; i <= 12; i++)
                        {
                            <div class="demo-item-title">Item @i</div>
                        }
                    </div>
                </ScrollArea>
            </div></div>
        </Examples>
    </DocPage>
}
else if (Slug == "empty")
{
    <DocPage Title="Empty" Description="Use the Empty component to display an empty state."
             Code="@EmptyCode" Usage="@EmptyUsage">
        <Preview>
            <div style="width: 100%; max-width: 480px">
                <Empty Class="border">
                    <EmptyHeader>
                        <EmptyMedia Variant="EmptyMediaVariant.Icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M21 8v13H3V8" />
                                <path d="M1 3h22v5H1z" />
                                <path d="M10 12h4" />
                            </svg>
                        </EmptyMedia>
                        <EmptyTitle>No projects yet</EmptyTitle>
                        <EmptyDescription>
                            You haven't created any projects yet. Get started by creating your first project.
                        </EmptyDescription>
                    </EmptyHeader>
                    <EmptyContent>
                        <div class="demo-row" style="justify-content: center">
                            <Button>Create project</Button>
                            <Button Variant="ButtonVariant.Outline">Import project</Button>
                        </div>
                    </EmptyContent>
                </Empty>
            </div>
        </Preview>
        <Examples>
            <h3 class="docs-example-title">Outline</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <div style="width: 100%; max-width: 480px">
                    <Empty Class="border border-dashed">
                        <EmptyHeader>
                            <EmptyMedia Variant="EmptyMediaVariant.Icon">
                                <SearchIcon />
                            </EmptyMedia>
                            <EmptyTitle>No results found</EmptyTitle>
                            <EmptyDescription>Try adjusting your search terms.</EmptyDescription>
                        </EmptyHeader>
                    </Empty>
                </div>
            </div></div>

            <h3 class="docs-example-title">Avatar</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <div style="width: 100%; max-width: 480px">
                    <Empty>
                        <EmptyHeader>
                            <EmptyMedia>
                                <Avatar><AvatarFallback>CN</AvatarFallback></Avatar>
                            </EmptyMedia>
                            <EmptyTitle>User offline</EmptyTitle>
                            <EmptyDescription>This user is currently offline.</EmptyDescription>
                        </EmptyHeader>
                    </Empty>
                </div>
            </div></div>

            <h3 class="docs-example-title">Avatar Group</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <div style="width: 100%; max-width: 480px">
                    <Empty>
                        <EmptyHeader>
                            <EmptyMedia>
                                <AvatarGroup>
                                    <Avatar><AvatarFallback>CN</AvatarFallback></Avatar>
                                    <Avatar><AvatarFallback>LR</AvatarFallback></Avatar>
                                    <AvatarGroupCount>+3</AvatarGroupCount>
                                </AvatarGroup>
                            </EmptyMedia>
                            <EmptyTitle>No team members</EmptyTitle>
                            <EmptyDescription>Invite your team to collaborate.</EmptyDescription>
                        </EmptyHeader>
                    </Empty>
                </div>
            </div></div>

            <h3 class="docs-example-title">Input Group</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <div style="width: 100%; max-width: 480px">
                    <Empty>
                        <EmptyHeader>
                            <EmptyTitle>Search projects</EmptyTitle>
                            <EmptyDescription>Find a project by name.</EmptyDescription>
                        </EmptyHeader>
                        <EmptyContent>
                            <InputGroup>
                                <InputGroupAddon><SearchIcon /></InputGroupAddon>
                                <InputGroupInput Placeholder="Search projects..." />
                            </InputGroup>
                        </EmptyContent>
                    </Empty>
                </div>
            </div></div>
        </Examples>
    </DocPage>
}

else if (Slug == "button-group")
{
    <DocPage Title="Button Group" Description="A container that groups related buttons together with consistent styling."
             Code="@ButtonGroupCode" Usage="@ButtonGroupUsage">
        <Preview>
            <ButtonGroup>
                <Button Variant="ButtonVariant.Outline">Copy</Button>
                <Button Variant="ButtonVariant.Outline">Cut</Button>
                <Button Variant="ButtonVariant.Outline">Paste</Button>
            </ButtonGroup>
        </Preview>
        <Examples>
            <h3 class="docs-example-title">Vertical</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <ButtonGroup Orientation="ShadcnOrientation.Vertical">
                    <Button Variant="ButtonVariant.Outline">Top</Button>
                    <Button Variant="ButtonVariant.Outline">Middle</Button>
                    <Button Variant="ButtonVariant.Outline">Bottom</Button>
                </ButtonGroup>
            </div></div>

            <h3 class="docs-example-title">With separator and text</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <ButtonGroup>
                    <Button Variant="ButtonVariant.Outline">Bold</Button>
                    <ButtonGroupSeparator />
                    <Button Variant="ButtonVariant.Outline">Italic</Button>
                </ButtonGroup>
                <ButtonGroup>
                    <ButtonGroupText>https://</ButtonGroupText>
                    <Button Variant="ButtonVariant.Outline">Open</Button>
                </ButtonGroup>
            </div></div>

            <h3 class="docs-example-title">Size</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <ButtonGroup>
                    <Button Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">Small</Button>
                    <Button Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">Button</Button>
                </ButtonGroup>
                <ButtonGroup>
                    <Button Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">Large</Button>
                    <Button Size="ButtonSize.Lg" Variant="ButtonVariant.Outline">Button</Button>
                </ButtonGroup>
            </div></div>

            <h3 class="docs-example-title">Split</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <ButtonGroup>
                    <Button Variant="ButtonVariant.Secondary">Button</Button>
                    <ButtonGroupSeparator />
                    <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Icon" aria-label="More">…</Button>
                </ButtonGroup>
            </div></div>

            <h3 class="docs-example-title">Input</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <ButtonGroup>
                    <Input Placeholder="Search..." Class="w-48" />
                    <Button Variant="ButtonVariant.Outline">Search</Button>
                </ButtonGroup>
            </div></div>

            <h3 class="docs-example-title">Dropdown</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <ButtonGroup>
                    <Button Variant="ButtonVariant.Outline">Follow</Button>
                    <DropdownMenu>
                        <DropdownMenuTrigger>
                            <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" aria-label="More options">…</Button>
                        </DropdownMenuTrigger>
                        <DropdownMenuContent Align="end">
                            <DropdownMenuItem>Mute</DropdownMenuItem>
                            <DropdownMenuItem>Block</DropdownMenuItem>
                        </DropdownMenuContent>
                    </DropdownMenu>
                </ButtonGroup>
            </div></div>
        </Examples>
    </DocPage>
}
else if (Slug == "item")
{
    <DocPage Title="Item" Description="A flexible component for displaying an item in a container."
             Code="@ItemCode" Usage="@ItemUsage">
        <Preview>
            <div style="width: 100%; max-width: 460px">
                <Item Variant="ItemVariant.Outline">
                    <ItemMedia Variant="ItemMediaVariant.Icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M12 2 2 7l10 5 10-5-10-5Z" />
                            <path d="m2 17 10 5 10-5" />
                        </svg>
                    </ItemMedia>
                    <ItemContent>
                        <ItemTitle>Design system</ItemTitle>
                        <ItemDescription>Tokens, primitives and docs in one place.</ItemDescription>
                    </ItemContent>
                    <ItemActions><Button Size="ButtonSize.Sm">Open</Button></ItemActions>
                </Item>
            </div>
        </Preview>
        <Examples>
            <h3 class="docs-example-title">Group with separators</h3>
            <div class="docs-preview"><div class="docs-preview-body docs-preview-block">
                <ItemGroup>
                    <Item>
                        <ItemContent><ItemTitle>Notifications</ItemTitle></ItemContent>
                        <ItemActions><Switch Checked="true" /></ItemActions>
                    </Item>
                    <ItemSeparator />
                    <Item>
                        <ItemContent><ItemTitle>Sounds</ItemTitle></ItemContent>
                        <ItemActions><Switch /></ItemActions>
                    </Item>
                </ItemGroup>
            </div></div>

            <h3 class="docs-example-title">Variant</h3>
            <div class="docs-preview"><div class="docs-preview-body" style="flex-direction: column; align-items: stretch">
                <div class="demo-stack" style="max-width: 460px">
                    <Item Variant="ItemVariant.Outline"><ItemContent><ItemTitle>Outline</ItemTitle><ItemDescription>Bordered item.</ItemDescription></ItemContent></Item>
                    <Item Variant="ItemVariant.Muted"><ItemContent><ItemTitle>Muted</ItemTitle><ItemDescription>Muted background.</ItemDescription></ItemContent></Item>
                </div>
            </div></div>

            <h3 class="docs-example-title">Size</h3>
            <div class="docs-preview"><div class="docs-preview-body" style="flex-direction: column; align-items: stretch">
                <div class="demo-stack" style="max-width: 460px">
                    <Item Size="ItemSize.Sm"><ItemContent><ItemTitle>Small</ItemTitle><ItemDescription>Compact padding.</ItemDescription></ItemContent></Item>
                </div>
            </div></div>

            <h3 class="docs-example-title">Avatar</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <div style="width: 100%; max-width: 460px">
                    <Item>
                        <ItemMedia>
                            <Avatar><AvatarFallback>CN</AvatarFallback></Avatar>
                        </ItemMedia>
                        <ItemContent>
                            <ItemTitle>shadcn</ItemTitle>
                            <ItemDescription>hello@example.com</ItemDescription>
                        </ItemContent>
                        <ItemActions><Button Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">Invite</Button></ItemActions>
                    </Item>
                </div>
            </div></div>

            <h3 class="docs-example-title">Header</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <div style="width: 100%; max-width: 460px">
                    <Item Variant="ItemVariant.Outline">
                        <ItemHeader><ItemTitle>Project files</ItemTitle><Badge Variant="BadgeVariant.Secondary">12</Badge></ItemHeader>
                        <ItemContent><ItemDescription>Updated 2 hours ago.</ItemDescription></ItemContent>
                        <ItemFooter><Button Size="ButtonSize.Sm">Open</Button></ItemFooter>
                    </Item>
                </div>
            </div></div>

            <h3 class="docs-example-title">Link</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <div style="width: 100%; max-width: 460px">
                    <a href="#item-link" class="demo-link">
                        <Item Variant="ItemVariant.Outline">
                            <ItemContent><ItemTitle>Open the docs</ItemTitle><ItemDescription>This whole item is a link.</ItemDescription></ItemContent>
                            <ItemActions><ChevronRightIcon /></ItemActions>
                        </Item>
                    </a>
                </div>
            </div></div>
        </Examples>
    </DocPage>
}
else if (Slug == "hover-card")
{
    <DocPage Title="Hover Card" Description="For sighted users to preview content available behind a link."
             Code="@HoverCardCode" Usage="@HoverCardUsage">
        <Preview>
            <HoverCard>
                <HoverCardTrigger>
                    <a href="#hover-card" class="demo-link">hover me</a>
                </HoverCardTrigger>
                <HoverCardContent>
                    <div class="demo-stack" style="gap: 8px">
                        <div class="demo-item-title">Design system</div>
                        <div class="demo-item-text">Tokens, primitives and docs in one place.</div>
                    </div>
                </HoverCardContent>
            </HoverCard>
        </Preview>
        <Examples>
            <h3 class="docs-example-title">Sides</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                @foreach (var side in new[] { "top", "right", "bottom", "left" })
                {
                    <HoverCard>
                        <HoverCardTrigger><a href="#hover-card-sides" class="demo-link">@side</a></HoverCardTrigger>
                        <HoverCardContent Side="@side">
                            <div class="demo-item-text">This card opens on the @side.</div>
                        </HoverCardContent>
                    </HoverCard>
                }
            </div></div>

            <h3 class="docs-example-title">Trigger Delays</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <HoverCard OpenDelay="100" CloseDelay="100">
                    <HoverCardTrigger><a href="#hover-card-delay" class="demo-link">fast</a></HoverCardTrigger>
                    <HoverCardContent><div class="demo-item-text">Opens after 100 ms.</div></HoverCardContent>
                </HoverCard>
                <HoverCard OpenDelay="700" CloseDelay="300">
                    <HoverCardTrigger><a href="#hover-card-delay" class="demo-link">slow</a></HoverCardTrigger>
                    <HoverCardContent><div class="demo-item-text">Opens after 700 ms.</div></HoverCardContent>
                </HoverCard>
            </div></div>
        </Examples>
    </DocPage>
}
else if (Slug == "input-group")
{
    <DocPage Title="Input Group" Description="A set of composable input components for building rich form controls."
             Code="@InputGroupCode" Usage="@InputGroupUsage">
        <Preview>
            <div style="width: 100%; max-width: 420px">
                <InputGroup>
                    <InputGroupAddon>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <circle cx="11" cy="11" r="8" />
                            <path d="m21 21-4.3-4.3" />
                        </svg>
                    </InputGroupAddon>
                    <InputGroupInput Placeholder="Search…" />
                    <InputGroupAddon Align="InputGroupAlign.InlineEnd">
                        <InputGroupText>⌘K</InputGroupText>
                    </InputGroupAddon>
                </InputGroup>
            </div>
        </Preview>
        <Examples>
            <h3 class="docs-example-title">With button</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <div style="width: 100%; max-width: 420px">
                    <InputGroup>
                        <InputGroupInput Placeholder="Enter your email" Type="email" />
                        <InputGroupAddon Align="InputGroupAlign.InlineEnd">
                            <InputGroupButton Variant="ButtonVariant.Default">Subscribe</InputGroupButton>
                        </InputGroupAddon>
                    </InputGroup>
                </div>
            </div></div>

            <h3 class="docs-example-title">Icon</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <div style="width: 100%; max-width: 420px">
                    <InputGroup>
                        <InputGroupAddon><SearchIcon /></InputGroupAddon>
                        <InputGroupInput Placeholder="Search..." />
                    </InputGroup>
                </div>
            </div></div>

            <h3 class="docs-example-title">Text</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <div style="width: 100%; max-width: 420px">
                    <InputGroup>
                        <InputGroupAddon><InputGroupText>https://</InputGroupText></InputGroupAddon>
                        <InputGroupInput Placeholder="example.com" />
                    </InputGroup>
                </div>
            </div></div>

            <h3 class="docs-example-title">Kbd</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <div style="width: 100%; max-width: 420px">
                    <InputGroup>
