@namespace DB.Blazor.ShadcnUI.Demo.Client.Docs

@if (Slug == "aspect-ratio")
{
    <DocPage Title="Aspect Ratio" Description="Displays content within a desired ratio."
             Code="@AspectCode" Usage="@AspectUsage">
        <Preview>
            <div style="width: 100%; max-width: 420px">
                <AspectRatio Ratio="16.0 / 9.0" Class="overflow-hidden rounded-lg bg-muted">
                    <div class="demo-row" style="height: 100%; align-items: center; justify-content: center">
                        <span class="demo-item-text">16 : 9</span>
                    </div>
                </AspectRatio>
            </div>
        </Preview>
        <Examples>
            <h3 class="docs-example-title">Square</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <AspectRatio Ratio="1" Class="w-40 rounded-lg bg-muted">
                    <div class="demo-row" style="height: 100%; align-items: center; justify-content: center">
                        <span class="demo-item-text">1 : 1</span>
                    </div>
                </AspectRatio>
            </div></div>
        </Examples>
    </DocPage>
}
else if (Slug == "toggle")
{
    <DocPage Title="Toggle" Description="A two-state button that can be either on or off."
             Code="@ToggleCode" Usage="@ToggleUsage">
        <Preview>
            <Toggle aria-label="Toggle bookmark">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2Z" />
                </svg>
            </Toggle>
        </Preview>
        <Examples>
            <h3 class="docs-example-title">Outline</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <Toggle Variant="ToggleVariant.Outline" aria-label="Toggle italic">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M19 4h-9M14 20H5M15 4 9 20" />
                    </svg>
                </Toggle>
            </div></div>

            <h3 class="docs-example-title">Size</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <Toggle Size="ToggleSize.Sm" aria-label="Toggle small">Sm</Toggle>
                <Toggle aria-label="Toggle default">Default</Toggle>
                <Toggle Size="ToggleSize.Lg" aria-label="Toggle large">Lg</Toggle>
            </div></div>

            <h3 class="docs-example-title">Disabled</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <Toggle Disabled="true">Underline</Toggle>
            </div></div>
        </Examples>
    </DocPage>
}
else if (Slug == "toggle-group")
{
    <DocPage Title="Toggle Group" Description="A set of two-state buttons that can be toggled on or off."
             Code="@ToggleGroupCode" Usage="@ToggleGroupUsage">
        <Preview>
            <ToggleGroup Type="ToggleGroupType.Single" Value="center">
                <ToggleGroupItem Value="left" aria-label="Align left">Left</ToggleGroupItem>
                <ToggleGroupItem Value="center" aria-label="Align center">Center</ToggleGroupItem>
                <ToggleGroupItem Value="right" aria-label="Align right">Right</ToggleGroupItem>
            </ToggleGroup>
        </Preview>
        <Examples>
            <h3 class="docs-example-title">Outline with spacing</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <ToggleGroup Type="ToggleGroupType.Single" Variant="ToggleVariant.Outline" Spacing="1" Value="bold">
                    <ToggleGroupItem Value="bold" aria-label="Bold">Bold</ToggleGroupItem>
                    <ToggleGroupItem Value="italic" aria-label="Italic">Italic</ToggleGroupItem>
                    <ToggleGroupItem Value="underline" aria-label="Underline">Underline</ToggleGroupItem>
                </ToggleGroup>
            </div></div>
        </Examples>
    </DocPage>
}
else if (Slug == "collapsible")
{
    <DocPage Title="Collapsible" Description="An interactive component which expands/collapses a panel."
             Code="@CollapsibleCode" Usage="@CollapsibleUsage">
        <Preview>
            <div class="demo-stack" style="width: 100%; max-width: 360px">
                <div class="demo-row" style="justify-content: space-between">
                    <span class="demo-item-title">@(collapsibleOpen ? "3 repositories starred" : "1 repository starred")</span>
                    <Collapsible Open="@collapsibleOpen" OpenChanged="@(value => collapsibleOpen = value)">
                        <CollapsibleTrigger>
                            <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm">Toggle</Button>
                        </CollapsibleTrigger>
                        <CollapsibleContent>
                            <div class="demo-stack" style="margin-top: 8px">
                                <div class="demo-repo">radix-ui/primitives</div>
                                <div class="demo-repo">radix-ui/colors</div>
                                <div class="demo-repo">radix-ui/icons</div>
                            </div>
                        </CollapsibleContent>
                    </Collapsible>
                </div>
                <div class="demo-repo">radix-ui/react</div>
            </div>
        </Preview>
    </DocPage>
}
else if (Slug == "scroll-area")
{
    <DocPage Title="Scroll Area" Description="Augments native scroll functionality for custom, cross-browser styling."
             Code="@ScrollCode" Usage="@ScrollUsage">
        <Preview>
            <div style="width: 100%; max-width: 420px">
                <ScrollArea Class="h-56 w-full rounded-md border">
                    <div class="demo-stack" style="padding: 16px">
                        @for (var i = 1; i <= 12; i++)
                        {
                            <div class="demo-item-title">Item @i</div>
                            <Separator />
                        }
                    </div>
                </ScrollArea>
            </div>
        </Preview>
    </DocPage>
}
else if (Slug == "empty")
{
    <DocPage Title="Empty" Description="Use the Empty component to display an empty state."
             Code="@EmptyCode" Usage="@EmptyUsage">
        <Preview>
            <div style="width: 100%; max-width: 480px">
                <Empty Class="border">
                    <EmptyHeader>
                        <EmptyMedia Variant="EmptyMediaVariant.Icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M21 8v13H3V8" />
                                <path d="M1 3h22v5H1z" />
                                <path d="M10 12h4" />
                            </svg>
                        </EmptyMedia>
                        <EmptyTitle>No projects yet</EmptyTitle>
                        <EmptyDescription>
                            You haven't created any projects yet. Get started by creating your first project.
                        </EmptyDescription>
                    </EmptyHeader>
                    <EmptyContent>
                        <div class="demo-row" style="justify-content: center">
                            <Button>Create project</Button>
                            <Button Variant="ButtonVariant.Outline">Import project</Button>
                        </div>
                    </EmptyContent>
                </Empty>
            </div>
        </Preview>
    </DocPage>
}

else if (Slug == "button-group")
{
    <DocPage Title="Button Group" Description="A container that groups related buttons together with consistent styling."
             Code="@ButtonGroupCode" Usage="@ButtonGroupUsage">
        <Preview>
            <ButtonGroup>
                <Button Variant="ButtonVariant.Outline">Copy</Button>
                <Button Variant="ButtonVariant.Outline">Cut</Button>
                <Button Variant="ButtonVariant.Outline">Paste</Button>
            </ButtonGroup>
        </Preview>
        <Examples>
            <h3 class="docs-example-title">Vertical</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <ButtonGroup Orientation="ShadcnOrientation.Vertical">
                    <Button Variant="ButtonVariant.Outline">Top</Button>
                    <Button Variant="ButtonVariant.Outline">Middle</Button>
                    <Button Variant="ButtonVariant.Outline">Bottom</Button>
                </ButtonGroup>
            </div></div>

            <h3 class="docs-example-title">With separator and text</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <ButtonGroup>
                    <Button Variant="ButtonVariant.Outline">Bold</Button>
                    <ButtonGroupSeparator />
                    <Button Variant="ButtonVariant.Outline">Italic</Button>
                </ButtonGroup>
                <ButtonGroup>
                    <ButtonGroupText>https://</ButtonGroupText>
                    <Button Variant="ButtonVariant.Outline">Open</Button>
                </ButtonGroup>
            </div></div>
        </Examples>
    </DocPage>
}
else if (Slug == "item")
{
    <DocPage Title="Item" Description="A flexible component for displaying an item in a container."
             Code="@ItemCode" Usage="@ItemUsage">
        <Preview>
            <div style="width: 100%; max-width: 460px">
                <Item Variant="ItemVariant.Outline">
                    <ItemMedia Variant="ItemMediaVariant.Icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M12 2 2 7l10 5 10-5-10-5Z" />
                            <path d="m2 17 10 5 10-5" />
                        </svg>
                    </ItemMedia>
                    <ItemContent>
                        <ItemTitle>Design system</ItemTitle>
                        <ItemDescription>Tokens, primitives and docs in one place.</ItemDescription>
                    </ItemContent>
                    <ItemActions><Button Size="ButtonSize.Sm">Open</Button></ItemActions>
                </Item>
            </div>
        </Preview>
        <Examples>
            <h3 class="docs-example-title">Group with separators</h3>
            <div class="docs-preview"><div class="docs-preview-body docs-preview-block">
                <ItemGroup>
                    <Item>
                        <ItemContent><ItemTitle>Notifications</ItemTitle></ItemContent>
                        <ItemActions><Switch Checked="true" /></ItemActions>
                    </Item>
                    <ItemSeparator />
                    <Item>
                        <ItemContent><ItemTitle>Sounds</ItemTitle></ItemContent>
                        <ItemActions><Switch /></ItemActions>
                    </Item>
                </ItemGroup>
            </div></div>
        </Examples>
    </DocPage>
}
else if (Slug == "hover-card")
{
    <DocPage Title="Hover Card" Description="For sighted users to preview content available behind a link."
             Code="@HoverCardCode" Usage="@HoverCardUsage">
        <Preview>
            <HoverCard>
                <HoverCardTrigger>
                    <a href="#hover-card" class="demo-link">hover me</a>
                </HoverCardTrigger>
                <HoverCardContent>
                    <div class="demo-stack" style="gap: 8px">
                        <div class="demo-item-title">Design system</div>
                        <div class="demo-item-text">Tokens, primitives and docs in one place.</div>
                    </div>
                </HoverCardContent>
            </HoverCard>
        </Preview>
    </DocPage>
}
