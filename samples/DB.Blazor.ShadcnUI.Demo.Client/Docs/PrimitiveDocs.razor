            <div class="docs-preview"><div class="docs-preview-body">
                <Card Class="w-full max-w-xs">
                    <CardHeader>
                        <Skeleton Class="h-4 w-2/3" />
                        <Skeleton Class="h-4 w-1/2" />
                    </CardHeader>
                    <CardContent>
                        <Skeleton Class="aspect-video w-full" />
                    </CardContent>
                </Card>
            </div></div>

            <h3 class="docs-example-title">Text</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <div class="demo-stack" style="width: 100%; max-width: 320px; gap: 8px">
                    <Skeleton Class="h-4 w-full" />
                    <Skeleton Class="h-4 w-[90%]" />
                    <Skeleton Class="h-4 w-[80%]" />
                </div>
            </div></div>

            <h3 class="docs-example-title">Form</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <div class="demo-form" style="width: 100%; max-width: 320px">
                    <Skeleton Class="h-4 w-20" />
                    <Skeleton Class="h-9 w-full" />
                    <Skeleton Class="h-9 w-full" />
                    <Skeleton Class="h-9 w-24" />
                </div>
            </div></div>

            <h3 class="docs-example-title">Table</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <div class="demo-stack" style="width: 100%; max-width: 420px; gap: 8px">
                    <div class="demo-row"><Skeleton Class="h-4 w-1/3" /><Skeleton Class="h-4 w-1/4" /><Skeleton Class="h-4 w-1/4" /></div>
                    <div class="demo-row"><Skeleton Class="h-4 w-1/3" /><Skeleton Class="h-4 w-1/4" /><Skeleton Class="h-4 w-1/4" /></div>
                    <div class="demo-row"><Skeleton Class="h-4 w-1/3" /><Skeleton Class="h-4 w-1/4" /><Skeleton Class="h-4 w-1/4" /></div>
                </div>
            </div></div>
        </Examples>
    </DocPage>
}
else if (Slug == "progress")
{
    <DocPage Title="Progress" Description="Displays an indicator showing the completion progress of a task."
             Code="@ProgressCode" Usage="@ProgressUsage">
        <Preview>
            <Progress Value="33" Class="w-[60%]" />
        </Preview>
        <Examples>
            <h3 class="docs-example-title">With label</h3>
            <div class="docs-preview"><div class="docs-preview-body" style="flex-direction: column; align-items: stretch">
                <div class="demo-row" style="justify-content: space-between">
                    <span class="demo-item-title">Uploading</span>
                    <span class="demo-item-text">66%</span>
                </div>
                <Progress Value="66" />
            </div></div>
        </Examples>
    </DocPage>
}
else if (Slug == "spinner")
{
    <DocPage Title="Spinner" Description="An indicator that can be used to show a loading state."
             Code="@SpinnerCode" Usage="@SpinnerUsage">
        <Preview>
            <Spinner />
        </Preview>
        <Examples>
            <h3 class="docs-example-title">Size</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <Spinner Class="size-3" />
                <Spinner Class="size-4" />
                <Spinner Class="size-6" />
                <Spinner Class="size-8" />
            </div></div>

            <h3 class="docs-example-title">Button</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <Button Disabled="true"><Spinner /> Loading</Button>
                <Button Variant="ButtonVariant.Outline" Disabled="true"><Spinner /> Please wait</Button>
            </div></div>

            <h3 class="docs-example-title">Badge</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <Badge Variant="BadgeVariant.Secondary"><Spinner Class="size-3" /> Syncing</Badge>
                <Badge Variant="BadgeVariant.Outline"><Spinner Class="size-3" /> Generating</Badge>
            </div></div>
        </Examples>
    </DocPage>
}
else if (Slug == "kbd")
{
    <DocPage Title="Kbd" Description="Used to display keyboard keys or shortcuts."
             Code="@KbdCode" Usage="@KbdUsage">
        <Preview>
            <KbdGroup>
                <Kbd>Ctrl</Kbd>
                <Kbd>B</Kbd>
            </KbdGroup>
        </Preview>
        <Examples>
            <h3 class="docs-example-title">In a tooltip</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <TooltipProvider>
                    <Tooltip>
                        <TooltipTrigger>
                            <Button Variant="ButtonVariant.Outline">Save</Button>
                        </TooltipTrigger>
                        <TooltipContent>
                            Save changes <Kbd>Ctrl</Kbd> <Kbd>S</Kbd>
                        </TooltipContent>
                    </Tooltip>
                </TooltipProvider>
            </div></div>
        </Examples>
    </DocPage>
}

