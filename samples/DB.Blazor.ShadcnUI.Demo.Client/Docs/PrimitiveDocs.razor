@namespace DB.Blazor.ShadcnUI.Demo.Client.Docs

@if (Slug == "button")
{
    <DocPage Title="Button" Description="Displays a button or a component that looks like a button."
             Code="@ButtonCode" Usage="@ButtonUsage">
        <Preview>
            <Button>Button</Button>
        </Preview>
        <Examples>
            <h3 class="docs-example-title">Size</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <Button Size="ButtonSize.Xs">Extra Small</Button>
                <Button Size="ButtonSize.Sm">Small</Button>
                <Button Size="ButtonSize.Default">Default</Button>
                <Button Size="ButtonSize.Lg">Large</Button>
            </div></div>

            <h3 class="docs-example-title">Variants</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <Button Variant="ButtonVariant.Default">Default</Button>
                <Button Variant="ButtonVariant.Outline">Outline</Button>
                <Button Variant="ButtonVariant.Secondary">Secondary</Button>
                <Button Variant="ButtonVariant.Ghost">Ghost</Button>
                <Button Variant="ButtonVariant.Destructive">Destructive</Button>
                <Button Variant="ButtonVariant.Link">Link</Button>
            </div></div>

            <h3 class="docs-example-title">With Icon</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <Button>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M7 17 17 7" />
                        <path d="M7 7h10v10" />
                    </svg>
                    Login
                </Button>
                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" aria-label="Open">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="11" cy="11" r="8" />
                        <path d="m21 21-4.3-4.3" />
                    </svg>
                </Button>
            </div></div>

            <h3 class="docs-example-title">Rounded</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <Button Class="rounded-full">Get Started</Button>
            </div></div>

            <h3 class="docs-example-title">Spinner</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <Button Disabled="true"><Spinner /> Generating</Button>
                <Button Variant="ButtonVariant.Secondary" Disabled="true"><Spinner /> Downloading</Button>
            </div></div>

            <h3 class="docs-example-title">As Link</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <a href="#as-link" class="@ButtonVariants.Get(ButtonVariant.Link)">Login</a>
            </div></div>
        </Examples>
    </DocPage>
}
else if (Slug == "badge")
{
    <DocPage Title="Badge" Description="Displays a badge or a component that looks like a badge."
             Code="@BadgeCode" Usage="@BadgeUsage">
        <Preview>
            <Badge>Badge</Badge>
        </Preview>
        <Examples>
            <h3 class="docs-example-title">Variants</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <Badge Variant="BadgeVariant.Default">Default</Badge>
                <Badge Variant="BadgeVariant.Secondary">Secondary</Badge>
                <Badge Variant="BadgeVariant.Destructive">Destructive</Badge>
                <Badge Variant="BadgeVariant.Outline">Outline</Badge>
            </div></div>

            <h3 class="docs-example-title">With Icon</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <Badge><CheckIcon /> Verified</Badge>
                <Badge Variant="BadgeVariant.Secondary"><LoaderIcon /> Syncing</Badge>
                <Badge Variant="BadgeVariant.Outline"><XIcon /> Failed</Badge>
            </div></div>

            <h3 class="docs-example-title">With Spinner</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <Badge Variant="BadgeVariant.Secondary"><Spinner Class="size-3" /> Generating</Badge>
            </div></div>

            <h3 class="docs-example-title">Link</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <a href="#badge-link" class="@BadgeVariants.Get(BadgeVariant.Link)">Read the docs</a>
            </div></div>

            <h3 class="docs-example-title">Custom Colors</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <Badge Class="bg-blue-500 text-white dark:bg-blue-600">Blue</Badge>
                <Badge Class="bg-emerald-500 text-white dark:bg-emerald-600">Emerald</Badge>
                <Badge Class="bg-rose-500 text-white dark:bg-rose-600">Rose</Badge>
            </div></div>
        </Examples>
    </DocPage>
}
else if (Slug == "card")
{
    <DocPage Title="Card" Description="Displays a card with header, content, and footer."
             Code="@CardCode" Usage="@CardUsage">
        <Preview>
            <Card Class="w-full max-w-sm">
                <CardHeader>
                    <CardTitle>Login to your account</CardTitle>
                    <CardDescription>Enter your email below to login to your account</CardDescription>
                    <CardAction>
                        <Button Variant="ButtonVariant.Link">Sign Up</Button>
                    </CardAction>
                </CardHeader>
                <CardContent>
                    <div class="demo-form">
                        <Label For="card-email">Email</Label>
                        <Input id="card-email" Type="email" Placeholder="m@example.com" />
                        <div class="demo-form-row">
                            <Label For="card-password">Password</Label>
                            <a href="#card" class="demo-link">Forgot your password?</a>
                        </div>
                        <Input id="card-password" Type="password" />
                    </div>
                </CardContent>
                <CardFooter Class="flex-col gap-2">
                    <Button Class="w-full">Login</Button>
                    <Button Variant="ButtonVariant.Outline" Class="w-full">Login with Google</Button>
                </CardFooter>
            </Card>
        </Preview>
        <Examples>
            <h3 class="docs-example-title">Create project</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <Card Class="w-full max-w-sm">
                    <CardHeader>
                        <CardTitle>Create project</CardTitle>
                        <CardDescription>Deploy your new project in one-click.</CardDescription>
                    </CardHeader>
                    <CardContent>
                        <div class="demo-form">
                            <Label For="project-name">Name</Label>
                            <Input id="project-name" Placeholder="Name of your project" />
                            <Label For="project-framework">Framework</Label>
                            <NativeSelect id="project-framework" Value="next">
                                <NativeSelectOption Value="next">Next.js</NativeSelectOption>
                                <NativeSelectOption Value="sveltekit">SvelteKit</NativeSelectOption>
                                <NativeSelectOption Value="astro">Astro</NativeSelectOption>
                                <NativeSelectOption Value="nuxt">Nuxt.js</NativeSelectOption>
                            </NativeSelect>
                        </div>
                    </CardContent>
                    <CardFooter Class="justify-between">
                        <Button Variant="ButtonVariant.Outline">Cancel</Button>
                        <Button>Deploy</Button>
                    </CardFooter>
                </Card>
            </div></div>
        </Examples>
    </DocPage>
}
else if (Slug == "alert")
{
    <DocPage Title="Alert" Description="Displays a callout for user attention."
             Code="@AlertCode" Usage="@AlertUsage">
        <Preview>
            <Alert Class="w-full">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <circle cx="12" cy="12" r="10" />
                    <path d="M12 16v-4M12 8h.01" />
                </svg>
                <AlertTitle>Heads up!</AlertTitle>
                <AlertDescription>You can add components and dependencies to your app using the cli.</AlertDescription>
            </Alert>
        </Preview>
        <Examples>
            <h3 class="docs-example-title">Destructive</h3>
            <div class="docs-preview"><div class="docs-preview-body" style="flex-direction: column; align-items: stretch">
                <Alert Variant="AlertVariant.Destructive">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="12" cy="12" r="10" />
                        <path d="M12 8v4M12 16h.01" />
                    </svg>
                    <AlertTitle>Error</AlertTitle>
                    <AlertDescription>Your session has expired. Please log in again.</AlertDescription>
                </Alert>
            </div></div>

            <h3 class="docs-example-title">Action</h3>
            <div class="docs-preview"><div class="docs-preview-body" style="flex-direction: column; align-items: stretch">
                <Alert>
                    <AlertTitle>Heads up!</AlertTitle>
                    <AlertDescription>
                        <p>You can add components to your app using the cli.</p>
                        <Button Size="ButtonSize.Xs" Variant="ButtonVariant.Outline">Enable</Button>
                    </AlertDescription>
                </Alert>
            </div></div>

            <h3 class="docs-example-title">Custom Colors</h3>
            <div class="docs-preview"><div class="docs-preview-body" style="flex-direction: column; align-items: stretch">
                <Alert Class="border-emerald-500/40 bg-emerald-500/10 text-emerald-700 dark:text-emerald-300">
                    <AlertTitle>Success</AlertTitle>
                    <AlertDescription>Your changes have been saved.</AlertDescription>
                </Alert>
                <Alert Class="border-sky-500/40 bg-sky-500/10 text-sky-700 dark:text-sky-300">
                    <AlertTitle>Note</AlertTitle>
                    <AlertDescription>This action can be undone later.</AlertDescription>
                </Alert>
            </div></div>
        </Examples>
    </DocPage>
}
else if (Slug == "avatar")
{
    <DocPage Title="Avatar" Description="An image element with a fallback for representing the user."
             Code="@AvatarCode" Usage="@AvatarUsage">
        <Preview>
            <Avatar>
                <AvatarImage Src="https://github.com/shadcn.png" Alt="shadcn" />
                <AvatarFallback>CN</AvatarFallback>
            </Avatar>
        </Preview>
        <Examples>
            <h3 class="docs-example-title">Sizes</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <Avatar Size="AvatarSize.Sm"><AvatarFallback>SM</AvatarFallback></Avatar>
                <Avatar><AvatarFallback>DF</AvatarFallback></Avatar>
                <Avatar Size="AvatarSize.Lg"><AvatarFallback>LG</AvatarFallback></Avatar>
            </div></div>

            <h3 class="docs-example-title">With badge</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <Avatar>
                    <AvatarImage Src="https://github.com/shadcn.png" Alt="shadcn" />
                    <AvatarFallback>CN</AvatarFallback>
                    <AvatarBadge></AvatarBadge>
                </Avatar>
            </div></div>

            <h3 class="docs-example-title">Badge with Icon</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <Avatar>
                    <AvatarImage Src="https://github.com/shadcn.png" Alt="shadcn" />
                    <AvatarFallback>CN</AvatarFallback>
                    <AvatarBadge><CheckIcon /></AvatarBadge>
                </Avatar>
            </div></div>

            <h3 class="docs-example-title">Group</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <AvatarGroup>
                    <Avatar><AvatarFallback>CN</AvatarFallback></Avatar>
                    <Avatar><AvatarFallback>LR</AvatarFallback></Avatar>
                    <Avatar><AvatarFallback>ER</AvatarFallback></Avatar>
                    <AvatarGroupCount>+3</AvatarGroupCount>
                </AvatarGroup>
            </div></div>
        </Examples>
    </DocPage>
}
else if (Slug == "separator")
{
    <DocPage Title="Separator" Description="Visually or semantically separates content."
             Code="@SeparatorCode" Usage="@SeparatorUsage">
        <Preview>
            <div style="width: 100%; max-width: 420px">
                <div class="demo-stack">
                    <div>
                        <div class="demo-item-title">shadcn/ui</div>
                        <div class="demo-item-text">The Foundation for your Design System</div>
                    </div>
                    <Separator />
                    <div class="demo-row">
                        <span class="demo-item-text">Blog</span>
                        <span class="demo-item-text">Docs</span>
                        <span class="demo-item-text">Source</span>
                    </div>
                </div>
            </div>
        </Preview>
        <Examples>
            <h3 class="docs-example-title">Vertical</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <div class="demo-row">
                    <span class="demo-item-title">Blog</span>
                    <Separator Orientation="ShadcnOrientation.Vertical" Class="h-5" />
                    <span class="demo-item-title">Docs</span>
                    <Separator Orientation="ShadcnOrientation.Vertical" Class="h-5" />
                    <span class="demo-item-title">Source</span>
                </div>
            </div></div>

            <h3 class="docs-example-title">Menu</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <DropdownMenu>
                    <DropdownMenuTrigger><Button Variant="ButtonVariant.Outline">Open menu</Button></DropdownMenuTrigger>
                    <DropdownMenuContent Class="w-56">
                        <DropdownMenuItem>Profile</DropdownMenuItem>
                        <DropdownMenuItem>Billing</DropdownMenuItem>
                        <DropdownMenuSeparator />
                        <DropdownMenuItem>Team</DropdownMenuItem>
                        <DropdownMenuItem>Subscription</DropdownMenuItem>
                    </DropdownMenuContent>
                </DropdownMenu>
            </div></div>

            <h3 class="docs-example-title">List</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <div class="demo-stack" style="width: 100%; max-width: 420px">
                    <div class="demo-row"><span>Item 1</span></div>
                    <Separator />
                    <div class="demo-row"><span>Item 2</span></div>
                    <Separator />
                    <div class="demo-row"><span>Item 3</span></div>
                </div>
            </div></div>
        </Examples>
    </DocPage>
}
else if (Slug == "skeleton")
{
    <DocPage Title="Skeleton" Description="Use to show a placeholder while content is loading."
             Code="@SkeletonCode" Usage="@SkeletonUsage">
        <Preview>
            <div class="demo-user-card">
                <Skeleton Class="size-12 rounded-full" />
                <div class="demo-stack" style="gap: 8px; flex: 1">
                    <Skeleton Class="h-4 w-[160px]" />
                    <Skeleton Class="h-4 w-[120px]" />
                </div>
            </div>
        </Preview>
        <Examples>
