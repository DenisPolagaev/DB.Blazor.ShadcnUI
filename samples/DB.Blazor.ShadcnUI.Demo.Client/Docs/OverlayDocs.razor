else if (Slug == "popover")
{
    <DocPage Title="Popover" Description="Displays rich content in a portal, triggered by a button."
             Code="@PopoverCode" Usage="@PopoverUsage">
        <Preview>
            <Popover>
                <PopoverTrigger>
                    <Button Variant="ButtonVariant.Outline">Open popover</Button>
                </PopoverTrigger>
                <PopoverContent Class="w-80">
                    <div class="demo-form">
                        <h4 class="demo-item-title" style="margin: 0">Dimensions</h4>
                        <p class="demo-item-text" style="margin: 0">Set the dimensions for the layer.</p>
                        <div class="demo-grid-2" style="gap: 8px">
                            <div class="demo-form">
                                <Label For="popover-width">Width</Label>
                                <Input id="popover-width" Value="100%" />
                            </div>
                            <div class="demo-form">
                                <Label For="popover-height">Height</Label>
                                <Input id="popover-height" Value="25px" />
                            </div>
                        </div>
                    </div>
                </PopoverContent>
            </Popover>
        </Preview>
        <Examples>
            <h3 class="docs-example-title">Align</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <Popover>
                    <PopoverTrigger>
                        <Button Variant="ButtonVariant.Outline">Align start</Button>
                    </PopoverTrigger>
                    <PopoverContent Align="start" Class="w-64">
                        <p class="demo-item-text" style="margin: 0">Aligned to the start edge of the trigger.</p>
                    </PopoverContent>
                </Popover>
                <Popover>
                    <PopoverTrigger>
                        <Button Variant="ButtonVariant.Outline">Align end</Button>
                    </PopoverTrigger>
                    <PopoverContent Align="end" Class="w-64">
                        <p class="demo-item-text" style="margin: 0">Aligned to the end edge of the trigger.</p>
                    </PopoverContent>
                </Popover>
            </div></div>
        </Examples>
    </DocPage>
}
else if (Slug == "tooltip")
{
    <DocPage Title="Tooltip"
             Description="A popup that displays information related to an element when the element receives keyboard focus or the mouse hovers over it."
             Code="@TooltipCode" Usage="@TooltipUsage">
        <Preview>
            <TooltipProvider>
                <Tooltip>
                    <TooltipTrigger>
                        <Button Variant="ButtonVariant.Outline">Hover</Button>
                    </TooltipTrigger>
                    <TooltipContent>Add to library</TooltipContent>
                </Tooltip>
            </TooltipProvider>
        </Preview>
        <Examples>
            <h3 class="docs-example-title">Sides</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                @foreach (var side in new[] { "top", "right", "bottom", "left" })
                {
                    <TooltipProvider>
                        <Tooltip>
                            <TooltipTrigger>
                                <Button Variant="ButtonVariant.Outline">@side</Button>
                            </TooltipTrigger>
                            <TooltipContent Side="@side">Tooltip on the @side</TooltipContent>
                        </Tooltip>
                    </TooltipProvider>
                }
            </div></div>

            <h3 class="docs-example-title">With Keyboard Shortcut</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <TooltipProvider>
                    <Tooltip>
                        <TooltipTrigger>
                            <Button Variant="ButtonVariant.Outline">Save</Button>
                        </TooltipTrigger>
                        <TooltipContent>
                            Save changes <Kbd Class="ml-1.5">⌘S</Kbd>
                        </TooltipContent>
                    </Tooltip>
                </TooltipProvider>
            </div></div>

            <h3 class="docs-example-title">Disabled Button</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <TooltipProvider>
                    <Tooltip>
                        <TooltipTrigger>
                            <span tabindex="0" class="inline-block">
                                <Button Variant="ButtonVariant.Outline" Disabled="true">Disabled</Button>
                            </span>
                        </TooltipTrigger>
                        <TooltipContent>This action is not available.</TooltipContent>
                    </Tooltip>
                </TooltipProvider>
            </div></div>
        </Examples>
    </DocPage>
}

else if (Slug == "drawer")
{
    <DocPage Title="Drawer" Description="A drawer component for React."
             Code="@DrawerCode" Usage="@DrawerUsage">
        <Preview>
            <Drawer>
                <DrawerTrigger>
                    <Button Variant="ButtonVariant.Outline">Open drawer</Button>
                </DrawerTrigger>
                <DrawerContent>
                    <DrawerHeader>
                        <DrawerTitle>Are you absolutely sure?</DrawerTitle>
                        <DrawerDescription>This action cannot be undone.</DrawerDescription>
                    </DrawerHeader>
                    <DrawerFooter>
                        <Button>Submit</Button>
                        <DrawerClose>
                            <Button Variant="ButtonVariant.Outline">Cancel</Button>
                        </DrawerClose>
                    </DrawerFooter>
                </DrawerContent>
            </Drawer>
        </Preview>
        <Examples>
            <h3 class="docs-example-title">Sides</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                @foreach (var direction in new[] { DrawerDirection.Top, DrawerDirection.Right, DrawerDirection.Bottom, DrawerDirection.Left })
                {
                    <Drawer Direction="@direction">
                        <DrawerTrigger><Button Variant="ButtonVariant.Outline">@direction</Button></DrawerTrigger>
                        <DrawerContent>
                            <DrawerHeader>
                                <DrawerTitle>@direction drawer</DrawerTitle>
                                <DrawerDescription>This drawer slides from the @direction.</DrawerDescription>
                            </DrawerHeader>
                        </DrawerContent>
                    </Drawer>
                }
            </div></div>

            <h3 class="docs-example-title">Scrollable Content</h3>
            <div class="docs-preview"><div class="docs-preview-body">
                <Drawer>
                    <DrawerTrigger><Button Variant="ButtonVariant.Outline">Open drawer</Button></DrawerTrigger>
                    <DrawerContent>
                        <DrawerHeader>
                            <DrawerTitle>Scrollable Content</DrawerTitle>
                            <DrawerDescription>This drawer has a long, scrollable body.</DrawerDescription>
                        </DrawerHeader>
                        <div class="max-h-[50vh] overflow-y-auto px-4">
                            @for (var i = 0; i < 12; i++)
                            {
                                <p class="mb-4 leading-normal">
                                    This is some additional paragraph placeholder content for the scrollable drawer.
                                </p>
                            }
                        </div>
                        <DrawerFooter>
                            <DrawerClose><Button Variant="ButtonVariant.Outline">Close</Button></DrawerClose>
                        </DrawerFooter>
                    </DrawerContent>
                </Drawer>
            </div></div>
        </Examples>
    </DocPage>
}
