@namespace DB.Blazor.ShadcnUI.Demo.Client.Layout

<header class="site-header">
    <div class="site-header-inner">
        <a class="site-brand" href="/">
            <svg class="site-brand-mark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 aria-hidden="true">
                <path d="M12 2 2 7l10 5 10-5-10-5Z" />
                <path d="m2 17 10 5 10-5" />
                <path d="m2 12 10 5 10-5" />
            </svg>
            <span class="site-brand-text">shadcn/ui</span>
            <span class="site-brand-port">Blazor</span>
        </a>

        <nav class="site-nav" aria-label="Main">
            <a href="/docs/components" class="site-nav-link">Docs</a>
            <a href="/docs/components" class="site-nav-link">Components</a>
        </nav>

        <div class="site-actions">
            <a class="site-icon-button" href="https://github.com/DenisPolagaev/DB.Blazor.ShadcnUI" target="_blank"
               rel="noreferrer" aria-label="GitHub">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 .5a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.5-1.4-1.3-1.8-1.3-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.1 4.7 18 5 18 5c.7 1.7.3 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A11.5 11.5 0 0 0 12 .5Z" />
                </svg>
            </a>
            <button type="button" class="site-icon-button" aria-label="Toggle theme" @onclick="ToggleThemeAsync">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
                </svg>
            </button>
        </div>
    </div>
</header>

@code {
    [Inject] private IJSRuntime Js { get; set; } = default!;

    private async Task ToggleThemeAsync() =>
        await Js.InvokeVoidAsync("eval", "document.documentElement.classList.toggle('dark')");
}
