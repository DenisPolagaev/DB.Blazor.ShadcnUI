@namespace DP.ShadcnBlazor.Demo.Client.Pages

@page "/"

<PageTitle>DP.ShadcnBlazor — overview</PageTitle>

<h1 class="demo-title">DP.ShadcnBlazor</h1>
<p class="demo-lead">
    shadcn/ui ported to Blazor. Same component names, variants, <span class="demo-code">data-slot</span>
    markup and Tailwind class list as shadcn/ui v4 — this page is rendered from the library only.
</p>

<section class="demo-section">
    <h2 class="demo-section-title">Button</h2>
    <div class="demo-row">
        <Button>Default</Button>
        <Button Variant="ButtonVariant.Secondary">Secondary</Button>
        <Button Variant="ButtonVariant.Destructive">Destructive</Button>
        <Button Variant="ButtonVariant.Outline">Outline</Button>
        <Button Variant="ButtonVariant.Ghost">Ghost</Button>
        <Button Variant="ButtonVariant.Link">Link</Button>
        <Button Disabled="true">Disabled</Button>
    </div>
    <div class="demo-row" style="margin-top: 16px">
        <Button Size="ButtonSize.Sm">Small</Button>
        <Button Size="ButtonSize.Lg">Large</Button>
        <Button Size="ButtonSize.Icon" aria-label="Search">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8" />
                <path d="m21 21-4.3-4.3" />
            </svg>
        </Button>
        <Button Href="#top">Link button</Button>
    </div>
</section>

<section class="demo-section">
    <h2 class="demo-section-title">Badge</h2>
    <div class="demo-row">
        <Badge>Default</Badge>
        <Badge Variant="BadgeVariant.Secondary">Secondary</Badge>
        <Badge Variant="BadgeVariant.Destructive">Destructive</Badge>
        <Badge Variant="BadgeVariant.Outline">Outline</Badge>
    </div>
</section>

<section class="demo-section">
    <h2 class="demo-section-title">Card</h2>
    <div class="demo-grid-2">
        <Card>
            <CardHeader>
                <CardTitle>Create project</CardTitle>
                <CardDescription>Deploy your new project in one click.</CardDescription>
                <CardAction>
                    <Badge Variant="BadgeVariant.Outline">New</Badge>
                </CardAction>
            </CardHeader>
            <CardContent>
                <p class="demo-muted" style="margin: 0">
                    Every card slot is a separate component, exactly like the shadcn/ui export.
                </p>
            </CardContent>
            <CardFooter>
                <Button Variant="ButtonVariant.Outline">Cancel</Button>
                <Button>Deploy</Button>
            </CardFooter>
        </Card>

        <Card>
            <CardHeader>
                <CardTitle>Notifications</CardTitle>
                <CardDescription>You have 3 unread messages.</CardDescription>
            </CardHeader>
            <CardContent>
                <div class="demo-stack">
                    <div class="demo-row">
                        <Avatar>
                            <AvatarFallback>DP</AvatarFallback>
                        </Avatar>
                        <div class="demo-stack" style="gap: 2px">
                            <span style="font-size: 14px; font-weight: 500">Deployment finished</span>
                            <span class="demo-muted">2 minutes ago</span>
                        </div>
                    </div>
                    <Separator />
                    <div class="demo-row">
                        <Progress Value="64" Class="flex-1" />
                        <span class="demo-muted">64%</span>
                    </div>
                </div>
            </CardContent>
        </Card>
    </div>
</section>

<section class="demo-section">
    <h2 class="demo-section-title">Alert</h2>
    <div class="demo-stack">
        <Alert>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10" />
                <path d="M12 16v-4M12 8h.01" />
            </svg>
            <AlertTitle>Heads up!</AlertTitle>
            <AlertDescription>You can add components to your app using the CLI.</AlertDescription>
        </Alert>
        <Alert Variant="AlertVariant.Destructive">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10" />
                <path d="M12 16v-4M12 8h.01" />
            </svg>
            <AlertTitle>Something went wrong</AlertTitle>
            <AlertDescription>Your session has expired. Please sign in again.</AlertDescription>
        </Alert>
    </div>
</section>

<section class="demo-section">
    <h2 class="demo-section-title">Avatar</h2>
    <div class="demo-avatars">
        <Avatar>
            <AvatarImage Src="https://github.com/shadcn.png" Alt="shadcn" />
            <AvatarFallback>CN</AvatarFallback>
            <AvatarBadge></AvatarBadge>
        </Avatar>
        <Avatar Size="AvatarSize.Sm"><AvatarFallback>SM</AvatarFallback></Avatar>
        <Avatar Size="AvatarSize.Lg"><AvatarFallback>LG</AvatarFallback></Avatar>
        <AvatarGroup>
            <Avatar><AvatarFallback>DP</AvatarFallback></Avatar>
            <Avatar><AvatarFallback>AB</AvatarFallback></Avatar>
            <AvatarGroupCount>+3</AvatarGroupCount>
        </AvatarGroup>
    </div>
</section>

<section class="demo-section">
    <h2 class="demo-section-title">Feedback &amp; decoration</h2>
    <div class="demo-grid-2">
        <div class="demo-stack">
            <div class="demo-row">
                <Spinner />
                <span class="demo-muted">Loading…</span>
                <Progress Value="35" Class="demo-narrow" />
            </div>
            <div class="demo-row">
                <KbdGroup>
                    <Kbd>Ctrl</Kbd>
                    <Kbd>K</Kbd>
                </KbdGroup>
                <span class="demo-muted">Open the command palette</span>
            </div>
            <Separator />
            <div class="demo-stack">
                <Skeleton Class="h-4 w-48" />
                <Skeleton Class="h-4 w-64" />
                <Skeleton Class="h-4 w-32" />
            </div>
        </div>
        <Card>
            <CardHeader>
                <CardTitle>Theme tokens</CardTitle>
                <CardDescription>Neutral preset, light and dark — the same oklch values as shadcn/ui.</CardDescription>
            </CardHeader>
            <CardContent>
                <div class="demo-row">
                    <div style="width: 32px; height: 32px; border-radius: 8px; background: var(--primary)"></div>
                    <div style="width: 32px; height: 32px; border-radius: 8px; background: var(--secondary)"></div>
                    <div style="width: 32px; height: 32px; border-radius: 8px; background: var(--muted)"></div>
                    <div style="width: 32px; height: 32px; border-radius: 8px; background: var(--accent)"></div>
                    <div style="width: 32px; height: 32px; border-radius: 8px; background: var(--destructive)"></div>
                    <div style="width: 32px; height: 32px; border-radius: 8px; background: var(--ring)"></div>
                </div>
            </CardContent>
        </Card>
    </div>
</section>
