@namespace DP.ShadcnBlazor.Demo.Client.Pages

@page "/overlays"

<PageTitle>DP.ShadcnBlazor — overlays</PageTitle>

<h1 class="demo-title">Overlays</h1>
<p class="demo-lead">
    Dialogs, sheets, menus, popovers and tooltips. Focus trap, Escape, scroll lock, outside click and
    placement all come from the library's single JS module.
</p>

<section class="demo-section">
    <h2 class="demo-section-title">Dialog &amp; alert dialog</h2>
    <div class="demo-row">
        <Dialog>
            <DialogTrigger>
                <Button Variant="ButtonVariant.Outline">Edit profile</Button>
            </DialogTrigger>
            <DialogContent>
                <DialogHeader>
                    <DialogTitle>Edit profile</DialogTitle>
                    <DialogDescription>
                        Make changes to your profile here. Click save when you are done.
                    </DialogDescription>
                </DialogHeader>
                <div class="demo-stack">
                    <Label For="dialog-name">Name</Label>
                    <Input Id="dialog-name" Value="Denis Polagaev" />
                </div>
                <DialogFooter ShowCloseButton="true">
                    <Button>Save changes</Button>
                </DialogFooter>
            </DialogContent>
        </Dialog>

        <AlertDialog>
            <AlertDialogTrigger>
                <Button Variant="ButtonVariant.Destructive">Delete account</Button>
            </AlertDialogTrigger>
            <AlertDialogContent>
                <AlertDialogHeader>
                    <AlertDialogTitle>Are you absolutely sure?</AlertDialogTitle>
                    <AlertDialogDescription>
                        This action cannot be undone. It permanently deletes your account and its data.
                    </AlertDialogDescription>
                </AlertDialogHeader>
                <AlertDialogFooter>
                    <AlertDialogCancel>Cancel</AlertDialogCancel>
                    <AlertDialogAction Variant="ButtonVariant.Destructive">Delete</AlertDialogAction>
                </AlertDialogFooter>
            </AlertDialogContent>
        </AlertDialog>

        <Sheet>
            <SheetTrigger>
                <Button Variant="ButtonVariant.Secondary">Open sheet</Button>
            </SheetTrigger>
            <SheetContent Side="SheetSide.Right">
                <SheetHeader>
                    <SheetTitle>Edit profile</SheetTitle>
                    <SheetDescription>This panel slides in from the right edge.</SheetDescription>
                </SheetHeader>
                <div style="padding: 0 16px" class="demo-stack">
                    <Label For="sheet-name">Name</Label>
                    <Input Id="sheet-name" Value="Denis" />
                </div>
                <SheetFooter>
                    <Button>Save changes</Button>
                </SheetFooter>
            </SheetContent>
        </Sheet>
    </div>
</section>

<section class="demo-section">
    <h2 class="demo-section-title">Menu</h2>
    <div class="demo-row">
        <DropdownMenu>
            <DropdownMenuTrigger>
                <Button Variant="ButtonVariant.Outline">Open menu</Button>
            </DropdownMenuTrigger>
            <DropdownMenuContent Align="start">
                <DropdownMenuLabel>My account</DropdownMenuLabel>
                <DropdownMenuSeparator />
                <DropdownMenuItem>
                    Profile
                    <DropdownMenuShortcut>⇧⌘P</DropdownMenuShortcut>
                </DropdownMenuItem>
                <DropdownMenuItem>
                    Billing
                    <DropdownMenuShortcut>⌘B</DropdownMenuShortcut>
                </DropdownMenuItem>
                <DropdownMenuItem>Settings</DropdownMenuItem>
                <DropdownMenuSeparator />
                <DropdownMenuSub>
                    <DropdownMenuSubTrigger>Invite users</DropdownMenuSubTrigger>
                    <DropdownMenuSubContent>
                        <DropdownMenuItem>Email</DropdownMenuItem>
                        <DropdownMenuItem>Message</DropdownMenuItem>
                        <DropdownMenuSeparator />
                        <DropdownMenuItem>More…</DropdownMenuItem>
                    </DropdownMenuSubContent>
                </DropdownMenuSub>
                <DropdownMenuCheckboxItem @bind-Checked="showBookmarks">Show bookmarks</DropdownMenuCheckboxItem>
                <DropdownMenuRadioGroup @bind-Value="position">
                    <DropdownMenuRadioItem Value="top">Panel top</DropdownMenuRadioItem>
                    <DropdownMenuRadioItem Value="bottom">Panel bottom</DropdownMenuRadioItem>
                </DropdownMenuRadioGroup>
                <DropdownMenuSeparator />
                <DropdownMenuItem Variant="DropdownMenuItemVariant.Destructive">Delete</DropdownMenuItem>
            </DropdownMenuContent>
        </DropdownMenu>

        <Popover>
            <PopoverTrigger>
                <Button Variant="ButtonVariant.Outline">Open popover</Button>
            </PopoverTrigger>
            <PopoverContent Class="w-80">
                <PopoverHeader>
                    <PopoverTitle>Dimensions</PopoverTitle>
                    <PopoverDescription>Set the dimensions for the layer.</PopoverDescription>
                </PopoverHeader>
                <div class="demo-stack" style="margin-top: 12px">
                    <Label For="popover-width">Width</Label>
                    <Input Id="popover-width" Value="100%" />
                </div>
            </PopoverContent>
        </Popover>

        <TooltipProvider>
            <Tooltip>
                <TooltipTrigger>
                    <Button Variant="ButtonVariant.Ghost">Hover me</Button>
                </TooltipTrigger>
                <TooltipContent>Add to library</TooltipContent>
            </Tooltip>
        </TooltipProvider>
    </div>
</section>

@code {
    private bool showBookmarks = true;
    private string? position = "bottom";
}
