@namespace DP.ShadcnBlazor.Demo.Client.Layout

@inherits LayoutComponentBase
@inject IJSRuntime Js

<div class="demo-shell">
    <header class="demo-header">
        <a class="demo-brand" href="/">DP.ShadcnBlazor</a>
        <nav class="demo-nav">
            <NavLink href="/" Match="NavLinkMatch.All">Overview</NavLink>
            <NavLink href="/forms">Forms</NavLink>
            <NavLink href="/data">Data</NavLink>
            <NavLink href="/overlays">Overlays</NavLink>
        </nav>
        <button type="button" class="demo-theme" aria-label="Toggle dark mode" @onclick="ToggleThemeAsync">
            ◐
        </button>
    </header>
    <main class="demo-main">
        @Body
    </main>
</div>

@code {
    private async Task ToggleThemeAsync() =>
        await Js.InvokeVoidAsync("eval", "document.documentElement.classList.toggle('dark')");
}
